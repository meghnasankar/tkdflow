      "end": 97.348713,
      "turn": null,
      "kihap": false
    },
    {
      "index": 17,
      "text": "Turn left into a cat stance. Extend the front knifehand while the other hand guards your body.",
      "start": 99.109761,
      "end": 104.640781,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
