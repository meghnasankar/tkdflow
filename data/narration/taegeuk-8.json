  "cues": [
    {
      "index": 0,
      "text": "Stand ready, with your hands held in front.",
      "start": 0.12,
      "end": 2.159002267573696,
      "turn": null,
      "kihap": false
    },
    {
      "index": 1,
      "text": "Set a back stance. Block with your left forearm, supported by the other hand.",
      "start": 2.539002,
      "end": 7.279048,
      "turn": null,
      "kihap": false
    },
    {
      "index": 2,
      "text": "Set a front stance. Punch to the middle with your right fist.",
      "start": 9.208104,
      "end": 12.81214,
      "turn": null,
      "kihap": false
    },
    {
      "index": 3,
      "text": "Lift off and extend a right front kick.",
      "start": 14.524814,
      "end": 16.943862,
      "turn": null,
      "kihap": false
    },
    {
      "index": 4,
      "text": "Lift off and extend a left front kick.",
      "start": 18.430823,
      "end": 20.814859,
      "turn": null,
      "kihap": false
    },
    {
      "index": 5,
      "text": "Land in a front stance. Sweep your left forearm inward across your body.",
      "start": 22.295152,
      "end": 26.897193,
      "turn": null,
      "kihap": false
    },
    {
      "index": 6,
      "text": "Punch to the middle with your right fist.",
      "start": 28.799962,
      "end": 30.697014,
      "turn": null,
      "kihap": false
    },
    {
      "index": 7,
      "text": "Punch to the middle with your left fist. Finish with a strong shout.",
      "start": 32.349962,
      "end": 36.335994,
      "turn": null,
      "kihap": true
    },
    {
      "index": 8,
      "text": "Set a front stance. Punch to the middle with your right fist.",
      "start": 38.121428,
      "end": 41.725464,
      "turn": null,
      "kihap": false
    },
    {
      "index": 9,
      "text": "Make a three-quarter turn to your left, then set a front stance. Raise your right arm while the other arm blocks low.",
      "start": 43.438138,
      "end": 50.152197,
      "turn": {
        "side": "left",
        "degrees": 270
      },
      "kihap": false
    },
    {
      "index": 10,
      "text": "Turn right into a front stance. Pull with one hand as your right fist rises in an uppercut.",
      "start": 52.457256,
      "end": 58.312267,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 11,
      "text": "Set a front stance. Raise your left arm while the other arm blocks low.",
      "start": 61.007256,
      "end": 65.423265,
      "turn": null,
      "kihap": false
    },
    {
      "index": 12,
      "text": "Turn left into a front stance. Pull with one hand as your left fist rises in an uppercut.",
      "start": 67.2906,
      "end": 72.786609,
      "turn": {
        "side": "left",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 13,
      "text": "Turn left into a back stance. Extend the front knifehand while the other hand guards your body.",
      "start": 75.8406,
      "end": 81.569625,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 14,
      "text": "Set a front stance. Punch to the middle with your right fist.",
      "start": 83.687058,
      "end": 87.291094,
      "turn": null,
      "kihap": false
    },
    {
      "index": 15,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 89.003768,
      "end": 91.910797,
      "turn": null,
      "kihap": false
    },
    {
      "index": 16,
      "text": "Land in a cat stance. Press the attack away with your right palm.",
