  "cues": [
    {
      "index": 0,
      "text": "Stand ready, with your hands held in front.",
      "start": 0.12,
      "end": 2.159002267573696,
      "turn": null,
      "kihap": false
    },
    {
      "index": 1,
      "text": "Turn left into a back stance. Extend the front knifehand while the other hand guards your body.",
      "start": 2.539002,
      "end": 8.268027,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 2,
      "text": "Set a front stance. Thrust your right fingertips forward with the other hand supporting.",
      "start": 10.385461,
      "end": 15.161515,
      "turn": null,
      "kihap": false
    },
    {
      "index": 3,
      "text": "Turn right into a back stance. Extend the front knifehand while the other hand guards your body.",
      "start": 17.097431,
      "end": 22.581467,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 4,
      "text": "Set a front stance. Thrust your left fingertips forward with the other hand supporting.",
      "start": 24.652236,
      "end": 29.439265,
      "turn": null,
      "kihap": false
    },
    {
      "index": 5,
      "text": "Turn left into a front stance. Strike with your right knifehand as the other hand blocks above.",
      "start": 31.377271,
      "end": 36.907339,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 6,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 38.986876,
      "end": 41.893905,
      "turn": null,
      "kihap": false
    },
    {
      "index": 7,
      "text": "Land in a front stance. Punch to the middle with your left fist.",
      "start": 43.473816,
      "end": 47.227875,
      "turn": null,
      "kihap": false
    },
    {
      "index": 8,
      "text": "Chamber your left knee, then extend a side kick.",
      "start": 48.969124,
      "end": 51.690167,
      "turn": null,
      "kihap": false
    },
    {
      "index": 9,
      "text": "Chamber your right knee, then extend a side kick.",
      "start": 53.234651,
      "end": 56.001726,
      "turn": null,
      "kihap": false
    },
    {
      "index": 10,
      "text": "Land in a back stance. Extend the front knifehand while the other hand guards your body.",
      "start": 57.554978,
      "end": 62.62101,
      "turn": null,
      "kihap": false
    },
    {
      "index": 11,
      "text": "Make a three-quarter turn to your left, then set a back stance. Move your left forearm outward to block.",
      "start": 64.612159,
      "end": 70.688213,
      "turn": {
        "side": "left",
        "degrees": 270
      },
      "kihap": false
    },
    {
      "index": 12,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 72.871748,
      "end": 75.778777,
      "turn": null,
      "kihap": false
    },
    {
      "index": 13,
      "text": "Land in a back stance. Sweep your right forearm inward across your body.",
      "start": 77.358688,
      "end": 81.565763,
      "turn": null,
      "kihap": false
    },
    {
      "index": 14,
      "text": "Turn right into a back stance. Move your right forearm outward to block.",
      "start": 83.393301,
      "end": 87.832349,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 15,
      "text": "Chamber your left knee, then extend a front kick.",
      "start": 89.704072,
      "end": 92.645115,
      "turn": null,
      "kihap": false
    },
    {
      "index": 16,
      "text": "Land in a back stance. Sweep your left forearm inward across your body.",
      "start": 94.231504,
      "end": 98.681572,
      "turn": null,
      "kihap": false
    },
    {
      "index": 17,
      "text": "Turn left into a front stance. Strike with your right knifehand as the other hand blocks above.",
      "start": 100.555395,
      "end": 106.085463,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 18,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 108.165,
      "end": 111.072029,
      "turn": null,
      "kihap": false
    },
    {
      "index": 19,
      "text": "Land in a front stance. Strike forward with your right backfist.",
      "start": 112.65194,
      "end": 116.834979,
      "turn": null,
      "kihap": false
    },
    {
      "index": 20,
      "text": "Turn left into a walking stance. Sweep your left forearm inward across your body.",
      "start": 118.657938,
      "end": 123.956986,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 21,
      "text": "Punch to the middle with your right fist.",
      "start": 125.992518,
      "end": 127.88957,
      "turn": null,
      "kihap": false
    },
    {
      "index": 22,
      "text": "Turn right into a walking stance. Sweep your right forearm inward across your body.",
      "start": 129.542518,
      "end": 134.561566,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 23,
      "text": "Punch to the middle with your left fist.",
      "start": 136.543765,
      "end": 138.753833,
      "turn": null,
      "kihap": false
    },
    {
      "index": 24,
      "text": "Turn left into a front stance. Sweep your left forearm inward across your body.",
      "start": 140.200989,
      "end": 145.093052,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 25,
      "text": "Punch to the middle with your right fist.",
      "start": 147.051065,
      "end": 148.948117,
      "turn": null,
      "kihap": false
    },
    {
      "index": 26,
      "text": "Punch to the middle with your left fist.",
      "start": 150.601065,
      "end": 152.811133,
      "turn": null,
      "kihap": false
    },
    {
      "index": 27,
      "text": "Set a front stance. Sweep your right forearm inward across your body.",
      "start": 154.258289,
      "end": 158.267359,
      "turn": null,
      "kihap": false
    },
    {
      "index": 28,
      "text": "Punch to the middle with your left fist.",
