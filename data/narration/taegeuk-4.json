      "end": 56.001726,
      "turn": null,
      "kihap": false
    },
    {
      "index": 10,
      "text": "Land in a back stance. Extend the front knifehand while the other hand guards your body.",
      "start": 57.554978,
      "end": 62.62101,
      "turn": null,
      "kihap": false
    },
    {
      "index": 11,
      "text": "Turn left into a back stance. Move your left forearm outward to block.",
