  "cues": [
    {
      "index": 0,
      "text": "Stand ready, with your hands held in front.",
      "start": 0.12,
      "end": 2.159002267573696,
      "turn": null,
      "kihap": false
    },
    {
      "index": 1,
      "text": "Turn left into a back stance. Extend the front knifehand while the other hand guards your body.",
      "start": 2.539002,
      "end": 8.268027,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 2,
      "text": "Set a front stance. Thrust your right fingertips forward with the other hand supporting.",
      "start": 10.385461,
      "end": 15.161515,
      "turn": null,
      "kihap": false
    },
    {
      "index": 3,
      "text": "Turn right into a back stance. Extend the front knifehand while the other hand guards your body.",
      "start": 17.097431,
      "end": 22.581467,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 4,
      "text": "Set a front stance. Thrust your left fingertips forward with the other hand supporting.",
      "start": 24.652236,
      "end": 29.439265,
      "turn": null,
      "kihap": false
    },
    {
      "index": 5,
      "text": "Turn left into a front stance. Strike with your right knifehand as the other hand blocks above.",
      "start": 31.377271,
      "end": 36.907339,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 6,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 38.986876,
      "end": 41.893905,
      "turn": null,
      "kihap": false
    },
    {
      "index": 7,
      "text": "Land in a front stance. Punch to the middle with your left fist.",
      "start": 43.473816,
      "end": 47.227875,
      "turn": null,
      "kihap": false
    },
    {
      "index": 8,
      "text": "Chamber your left knee, then extend a side kick.",
      "start": 48.969124,
      "end": 51.690167,
      "turn": null,
      "kihap": false
    },
    {
      "index": 9,
      "text": "Chamber your right knee, then extend a side kick.",
