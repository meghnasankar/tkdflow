      "end": 28.447697,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 6,
      "text": "Set a walking stance. Thrust your right fingertips forward with the other hand supporting.",
      "start": 30.310652,
      "end": 35.516729,
      "turn": null,
      "kihap": false
    },
    {
      "index": 7,
      "text": "Turn all the way around to the left. Strike forward with your left backfist.",
