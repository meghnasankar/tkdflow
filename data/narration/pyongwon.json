  "cues": [
    {
      "index": 0,
      "text": "Stand ready, with your hands held in front.",
      "start": 0.12,
      "end": 2.159002267573696,
      "turn": null,
      "kihap": false
    },
    {
      "index": 1,
      "text": "Set a parallel stance. Spread both open hands outward into the low block.",
      "start": 2.539002,
      "end": 7.536054,
      "turn": null,
      "kihap": false
    },
    {
      "index": 2,
      "text": "Bring both open hands together in front of your chest.",
      "start": 8.486054,
      "end": 11.416077,
      "turn": null,
      "kihap": false
    },
    {
      "index": 3,
      "text": "Turn right into a back stance. Sweep your right knifehand down to block.",
      "start": 12.366077,
      "end": 16.689116,
      "turn": {
        "side": "right",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 4,
      "text": "Turn left into a back stance. Extend your left knifehand out to the side.",
      "start": 18.538742,
      "end": 23.43076,
      "turn": {
        "side": "left",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 5,
      "text": "Set a front stance. Drive your right elbow upward.",
      "start": 25.388764,
      "end": 28.561825,
      "turn": null,
      "kihap": false
    },
    {
      "index": 6,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 30.192408,
      "end": 33.099437,
      "turn": null,
      "kihap": false
    },
    {
      "index": 7,
      "text": "Chamber your left knee, then extend a side kick.",
      "start": 34.679348,
      "end": 37.400391,
      "turn": null,
      "kihap": false
    },
    {
      "index": 8,
      "text": "Land in a back stance. Extend the front knifehand while the other hand guards your body.",
      "start": 38.944875,
      "end": 44.010907,
      "turn": null,
      "kihap": false
    },
    {
      "index": 9,
      "text": "Lower the front knifehand while the other hand guards your body.",
      "start": 46.002056,
      "end": 49.478065,
      "turn": null,
      "kihap": false
    },
    {
      "index": 10,
      "text": "Set a horse stance. Raise your right forearm to the side with the other hand supporting.",
      "start": 51.166353,
      "end": 56.325401,
      "turn": null,
      "kihap": false
    },
    {
      "index": 11,
      "text": "Draw back, then strike with your right backfist.",
      "start": 58.334267,
      "end": 61.473315,
      "turn": null,
      "kihap": false
    },
    {
      "index": 12,
      "text": "Draw back, then strike with your left backfist. Finish with a strong shout.",
      "start": 63.097419,
      "end": 67.815469,
      "turn": null,
      "kihap": true
    },
    {
      "index": 13,
      "text": "Set a cross stance. Drive both elbows outward to the sides.",
      "start": 69.740336,
      "end": 73.57639,
      "turn": null,
      "kihap": false
    },
    {
      "index": 14,
      "text": "Set a horse stance. Raise both forearms outward into the mountain block.",
      "start": 75.333258,
      "end": 79.667272,
      "turn": null,
      "kihap": false
    },
    {
      "index": 15,
      "text": "Balance on your left leg. Raise your left forearm above your head and block low with your right arm.",
      "start": 81.518988,
      "end": 87.549011,
      "turn": null,
      "kihap": false
    },
    {
      "index": 16,
      "text": "Balance on your left leg. Draw both fists back together beside your hip.",
      "start": 89.723777,
      "end": 94.116838,
      "turn": null,
      "kihap": false
    },
    {
      "index": 17,
      "text": "Chamber your right knee, then extend a side kick.",
      "start": 95.979802,
      "end": 98.746877,
      "turn": null,
      "kihap": false
    },
    {
      "index": 18,
      "text": "Land in a front stance. Drive your left elbow upward.",
      "start": 100.300129,
      "end": 103.799177,
      "turn": null,
      "kihap": false
    },
    {
      "index": 19,
      "text": "Chamber your left knee, then extend a front kick.",
      "start": 105.491852,
      "end": 108.432895,
      "turn": null,
      "kihap": false
    },
    {
      "index": 20,
      "text": "Chamber your right knee, then extend a side kick.",
      "start": 110.019284,
      "end": 112.786359,
      "turn": null,
      "kihap": false
    },
    {
      "index": 21,
      "text": "Land in a back stance. Extend the front knifehand while the other hand guards your body.",
      "start": 114.339611,
      "end": 119.405643,
      "turn": null,
      "kihap": false
    },
    {
      "index": 22,
      "text": "Lower the front knifehand while the other hand guards your body.",
      "start": 121.396792,
      "end": 124.872801,
      "turn": null,
      "kihap": false
    },
    {
      "index": 23,
      "text": "Set a horse stance. Raise your left forearm to the side with the other hand supporting.",
      "start": 126.561089,
      "end": 131.360137,
      "turn": null,
      "kihap": false
    },
    {
      "index": 24,
      "text": "Draw back, then strike with your left backfist.",
      "start": 133.300431,
      "end": 136.381474,
      "turn": null,
      "kihap": false
    },
    {
      "index": 25,
      "text": "Draw back, then strike with your right backfist. Finish with a strong shout.",
      "start": 137.99453,
      "end": 143.226548,
      "turn": null,
      "kihap": true
    },
    {
      "index": 26,
      "text": "Set a cross stance. Drive both elbows outward to the sides.",
      "start": 145.249314,
      "end": 149.085368,
      "turn": null,
      "kihap": false
    },
    {
      "index": 27,
      "text": "Set a horse stance. Raise both forearms outward into the mountain block.",
      "start": 150.842236,
      "end": 155.17625,
      "turn": null,
      "kihap": false
    },
    {
      "index": 28,
      "text": "Balance on your right leg. Raise your right forearm above your head and block low with your left arm.",
      "start": 157.027966,
      "end": 162.721027,
      "turn": null,
      "kihap": false
    },
    {
      "index": 29,
      "text": "Balance on your right leg. Draw both fists back together beside your hip.",
      "start": 164.83161,
      "end": 169.258685,
      "turn": null,
      "kihap": false
    },
    {
      "index": 30,
      "text": "Chamber your left knee, then extend a side kick.",
      "start": 171.128128,
      "end": 173.849171,
      "turn": null,
      "kihap": false
    },
    {
      "index": 31,
      "text": "Land in a front stance. Drive your right elbow toward the opposite open palm.",
      "start": 175.393655,
      "end": 180.204675,
      "turn": null,
      "kihap": false
    },
    {
      "index": 32,
      "text": "Return to the ready position.",
      "start": 182.247251,
      "end": 183.911333,
      "turn": null,
      "kihap": false
    }
  ],
