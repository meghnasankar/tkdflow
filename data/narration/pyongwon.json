  "cues": [
    {
      "index": 0,
      "text": "Stand ready, with your hands held in front.",
      "start": 0.12,
      "end": 2.159002267573696
    },
    {
      "index": 1,
      "text": "Set a parallel stance. Spread both open hands outward into the low block.",
      "start": 2.539002,
      "end": 7.536054
    },
    {
      "index": 2,
      "text": "Bring both open hands together in front of your chest.",
      "start": 8.386054,
      "end": 11.316077
    },
    {
      "index": 3,
      "text": "Turn right into a back stance. Sweep your right knifehand down to block.",
      "start": 12.166077,
      "end": 16.489116
    },
    {
      "index": 4,
      "text": "Turn left into a back stance. Extend your left knifehand out to the side.",
      "start": 17.339116,
      "end": 22.231134
    },
    {
      "index": 5,
      "text": "Set a front stance. Drive your right elbow upward.",
      "start": 23.081134,
      "end": 26.254195
    },
    {
      "index": 6,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 27.104195,
      "end": 30.011224
    },
    {
      "index": 7,
      "text": "Chamber your left knee, then extend a side kick.",
      "start": 30.861224,
      "end": 33.582267
    },
    {
      "index": 8,
      "text": "Land in a back stance. Extend the front knifehand while the other hand guards your body.",
      "start": 34.611224,
      "end": 39.677256
    },
    {
      "index": 9,
      "text": "Lower the front knifehand while the other hand guards your body.",
      "start": 40.527256,
      "end": 44.003265
    },
    {
      "index": 10,
      "text": "Set a horse stance. Raise your right forearm to the side with the other hand supporting.",
      "start": 44.853265,
      "end": 50.012313
    },
    {
      "index": 11,
      "text": "Draw back, then strike with your right backfist.",
      "start": 50.862313,
      "end": 54.001361
    },
    {
      "index": 12,
      "text": "Draw back, then strike with your left backfist. Finish with a strong shout.",
      "start": 54.851361,
      "end": 59.569411
    },
    {
      "index": 13,
      "text": "Set a cross stance. Drive both elbows outward to the sides.",
      "start": 60.419411,
      "end": 64.255465
    },
    {
      "index": 14,
      "text": "Set a horse stance. Raise both forearms outward into the mountain block.",
      "start": 65.105465,
      "end": 69.439479
    },
    {
      "index": 15,
      "text": "Balance on your left leg. Raise one arm high with the other forearm guarding across.",
      "start": 70.289479,
      "end": 75.216554
    },
    {
      "index": 16,
      "text": "Balance on your left leg. Draw both fists back together beside your hip.",
      "start": 76.066554,
      "end": 80.459615
    },
    {
      "index": 17,
      "text": "Chamber your right knee, then extend a side kick.",
      "start": 81.309615,
      "end": 84.07669
    },
    {
      "index": 18,
      "text": "Land in a front stance. Drive your left elbow upward.",
      "start": 85.059615,
      "end": 88.558663
    },
    {
      "index": 19,
      "text": "Chamber your left knee, then extend a front kick.",
      "start": 89.408663,
      "end": 92.349706
    },
    {
      "index": 20,
      "text": "Chamber your right knee, then extend a side kick.",
      "start": 93.199706,
      "end": 95.966781
    },
    {
      "index": 21,
      "text": "Land in a back stance. Extend the front knifehand while the other hand guards your body.",
      "start": 96.949706,
      "end": 102.015738
    },
    {
      "index": 22,
      "text": "Lower the front knifehand while the other hand guards your body.",
      "start": 102.865738,
      "end": 106.341747
    },
    {
      "index": 23,
      "text": "Set a horse stance. Raise your left forearm to the side with the other hand supporting.",
      "start": 107.191747,
      "end": 111.990795
    },
    {
      "index": 24,
      "text": "Draw back, then strike with your left backfist.",
      "start": 112.840795,
      "end": 115.921838
    },
    {
      "index": 25,
      "text": "Draw back, then strike with your right backfist. Finish with a strong shout.",
      "start": 116.771838,
      "end": 122.003856
    },
    {
      "index": 26,
      "text": "Set a cross stance. Drive both elbows outward to the sides.",
      "start": 122.853856,
      "end": 126.68991
    },
    {
      "index": 27,
      "text": "Set a horse stance. Raise both forearms outward into the mountain block.",
      "start": 127.53991,
      "end": 131.873924
    },
    {
      "index": 28,
      "text": "Balance on your right leg. Raise one arm high with the other forearm guarding across.",
      "start": 132.723924,
      "end": 137.673992
    },
    {
      "index": 29,
      "text": "Balance on your right leg. Draw both fists back together beside your hip.",
      "start": 138.523992,
      "end": 142.951067
    },
    {
      "index": 30,
      "text": "Chamber your left knee, then extend a side kick.",
      "start": 143.801067,
      "end": 146.52211
    },
    {
      "index": 31,
      "text": "Land in a front stance. Drive your right elbow toward the opposite open palm.",
      "start": 147.551067,
      "end": 152.362087
    },
    {
      "index": 32,
      "text": "Return to the ready position.",
      "start": 153.312087,
