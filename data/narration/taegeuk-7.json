  "cues": [
    {
      "index": 0,
      "text": "Stand ready, with your hands held in front.",
      "start": 0.12,
      "end": 2.159002267573696,
      "turn": null,
      "kihap": false
    },
    {
      "index": 1,
      "text": "Turn left into a cat stance. Press the attack away with your right palm.",
      "start": 2.539002,
      "end": 6.61805,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 2,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 8.421202,
      "end": 11.328231,
      "turn": null,
      "kihap": false
    },
    {
      "index": 3,
      "text": "Land in a cat stance. Sweep your left forearm inward across your body.",
      "start": 12.908142,
      "end": 17.220205,
      "turn": null,
      "kihap": false
    },
    {
      "index": 4,
      "text": "Turn right into a cat stance. Press the attack away with your left palm.",
      "start": 19.067741,
      "end": 23.193818,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 5,
      "text": "Chamber your left knee, then extend a front kick.",
      "start": 25.005928,
      "end": 27.946971,
      "turn": null,
      "kihap": false
    },
    {
      "index": 6,
      "text": "Land in a cat stance. Sweep your right forearm inward across your body.",
      "start": 29.53336,
      "end": 33.821387,
      "turn": null,
      "kihap": false
    },
    {
      "index": 7,
      "text": "Turn left into a back stance. Sweep your left knifehand down to block.",
      "start": 35.664345,
      "end": 40.022395,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 8,
      "text": "Set a back stance. Sweep your right knifehand down to block.",
      "start": 41.87869,
      "end": 45.725765,
      "turn": null,
      "kihap": false
    },
    {
      "index": 9,
      "text": "Turn left into a cat stance. Press the attack away with your right palm.",
      "start": 47.484731,
      "end": 51.563779,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 10,
      "text": "Strike forward with your right backfist.",
      "start": 53.366931,
      "end": 55.68099,
      "turn": null,
      "kihap": false
    },
    {
      "index": 11,
      "text": "Turn right into a cat stance. Press the attack away with your left palm.",
      "start": 57.147954,
      "end": 61.274031,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 12,
      "text": "Strike forward with your left backfist.",
      "start": 63.086141,
      "end": 65.38918,
      "turn": null,
      "kihap": false
    },
    {
      "index": 13,
      "text": "Turn left into a closed stance. Bring your hands together in front, with one hand covering the fist.",
      "start": 66.854044,
      "end": 73.186107,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 14,
      "text": "Set a front stance. Block outward with your left arm as the other arm blocks low.",
      "start": 74.136107,
      "end": 79.422139,
      "turn": null,
      "kihap": false
    },
    {
      "index": 15,
      "text": "Block outward with your right arm as the other arm blocks low.",
      "start": 81.455192,
      "end": 84.908208,
      "turn": null,
      "kihap": false
    },
    {
      "index": 16,
      "text": "Set a front stance. Block outward with your right arm as the other arm blocks low.",
      "start": 86.592116,
      "end": 91.751164,
      "turn": null,
      "kihap": false
    },
    {
      "index": 17,
      "text": "Block outward with your left arm as the other arm blocks low.",
      "start": 93.76003,
      "end": 97.235087,
      "turn": null,
      "kihap": false
    },
    {
      "index": 18,
      "text": "Make a three-quarter turn to your left, then set a front stance. Spread both forearms outward into a middle block.",
      "start": 98.923193,
      "end": 105.556254,
      "turn": {
        "side": "left",
        "degrees": 270
      },
      "kihap": false
    },
    {
      "index": 19,
      "text": "Pull your hands down as your right knee rises.",
      "start": 107.845885,
      "end": 110.635953,
      "turn": null,
      "kihap": false
    },
    {
      "index": 20,
      "text": "Land in a cross stance. Drive both fists forward and upward together.",
      "start": 112.193585,
      "end": 117.340614,
      "turn": null,
      "kihap": false
    },
    {
      "index": 21,
      "text": "Set a front stance. Cross both forearms in front for a low block.",
      "start": 119.347192,
      "end": 123.717215,
      "turn": null,
      "kihap": false
    },
    {
      "index": 22,
      "text": "Turn right into a front stance. Spread both forearms outward into a middle block.",
      "start": 125.57579,
      "end": 130.745813,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 23,
      "text": "Pull your hands down as your left knee rises.",
      "start": 132.756769,
      "end": 135.360805,
      "turn": null,
      "kihap": false
    },
    {
      "index": 24,
      "text": "Land in a cross stance. Drive both fists forward and upward together.",
      "start": 136.883003,
      "end": 142.030032,
      "turn": null,
      "kihap": false
    },
    {
      "index": 25,
      "text": "Set a front stance. Cross both forearms in front for a low block.",
      "start": 144.03661,
      "end": 148.406633,
      "turn": null,
      "kihap": false
    },
    {
      "index": 26,
      "text": "Turn left into a walking stance. Strike forward with your left backfist.",
      "start": 150.265208,
      "end": 154.693235,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 27,
      "text": "Swing your right leg inward in a crescent toward the opposite palm.",
      "start": 156.562859,
      "end": 160.296873,
      "turn": null,
      "kihap": false
    },
    {
      "index": 28,
      "text": "Land in a horse stance. Drive your right elbow toward the opposite open palm.",
      "start": 162.034304,
      "end": 166.625324,
      "turn": null,
      "kihap": false
    },
    {
      "index": 29,
      "text": "Set a walking stance. Strike forward with your right backfist.",
      "start": 168.525995,
      "end": 172.419056,
      "turn": null,
      "kihap": false
    },
    {
      "index": 30,
      "text": "Swing your left leg inward in a crescent toward the opposite palm.",
      "start": 174.186782,
      "end": 177.720796,
      "turn": null,
      "kihap": false
    },
    {
      "index": 31,
      "text": "Land in a horse stance. Drive your left elbow toward the opposite open palm.",
      "start": 179.420132,
      "end": 183.824168,
      "turn": null,
      "kihap": false
    },
    {
      "index": 32,
      "text": "Extend your left knifehand to block.",
      "start": 185.689223,
      "end": 187.934257,
      "turn": null,
      "kihap": false
    },
    {
      "index": 33,
      "text": "Punch out to the side with your right fist. Finish with a strong shout.",
      "start": 189.388073,
      "end": 193.537098,
      "turn": null,
      "kihap": true
    },
    {
      "index": 34,
      "text": "Return to the ready position.",
      "start": 195.453579,
      "end": 197.117661,
      "turn": null,
      "kihap": false
    }
  ],
