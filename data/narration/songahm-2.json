  "cues": [
    {
      "index": 0,
      "text": "Stand ready, with your hands held in front.",
      "start": 0.12,
      "end": 2.159002267573696,
      "turn": null,
      "kihap": false
    },
    {
      "index": 1,
      "text": "Set a back stance. Block with your left forearm, supported by the other hand.",
      "start": 2.539002,
      "end": 7.279048,
      "turn": null,
      "kihap": false
    },
    {
      "index": 2,
      "text": "Chamber your left knee, then extend a front kick.",
      "start": 9.208104,
      "end": 12.149147,
      "turn": null,
      "kihap": false
    },
    {
      "index": 3,
      "text": "Land in a front stance. Punch high with your right fist.",
      "start": 13.735536,
      "end": 17.710593,
      "turn": null,
      "kihap": false
    },
    {
      "index": 4,
      "text": "Chamber your right knee, then extend a roundhouse kick.",
      "start": 19.493937,
      "end": 22.505003,
      "turn": null,
      "kihap": false
    },
    {
      "index": 5,
      "text": "Turn left into a horse stance. Lower both forearms outward together to block.",
      "start": 24.10473,
      "end": 29.18278,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 6,
      "text": "Set a front stance. Move your left forearm outward to block.",
      "start": 31.176218,
      "end": 34.884245,
      "turn": null,
      "kihap": false
    },
    {
      "index": 7,
      "text": "Punch high with your right fist.",
      "start": 36.616727,
      "end": 38.501761,
      "turn": null,
      "kihap": false
    },
    {
      "index": 8,
      "text": "Set a front stance. Move your right forearm outward to block.",
      "start": 40.166727,
      "end": 44.012804,
      "turn": null,
      "kihap": false
    },
    {
      "index": 9,
      "text": "Punch high with your left fist.",
      "start": 45.771581,
      "end": 47.71462,
      "turn": null,
      "kihap": false
    },
    {
      "index": 10,
      "text": "Turn left into a back stance. Strike across with the edge of your left hand. Finish with a strong shout.",
      "start": 49.321581,
      "end": 55.560629,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": true
    },
    {
      "index": 11,
      "text": "Chamber your right knee, then extend a roundhouse kick.",
      "start": 57.775209,
      "end": 60.786275,
      "turn": null,
      "kihap": false
    },
    {
      "index": 12,
      "text": "Land in a back stance. Block with your right forearm, supported by the other hand.",
      "start": 62.386002,
      "end": 67.220061,
      "turn": null,
      "kihap": false
    },
    {
      "index": 13,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 69.167025,
      "end": 72.074054,
      "turn": null,
      "kihap": false
    },
    {
      "index": 14,
      "text": "Land in a front stance. Punch high with your left fist.",
      "start": 73.653965,
      "end": 77.419997,
      "turn": null,
      "kihap": false
    },
    {
      "index": 15,
      "text": "Chamber your left knee, then extend a roundhouse kick.",
      "start": 79.163527,
      "end": 82.314593,
      "turn": null,
      "kihap": false
    },
    {
      "index": 16,
      "text": "Turn right into a horse stance. Lower both forearms outward together to block.",
      "start": 83.940986,
      "end": 88.624025,
      "turn": {
        "side": "right",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 17,
      "text": "Turn right into a horse stance. Sweep your right arm down for a low block.",
      "start": 90.542222,
      "end": 94.656281,
      "turn": {
        "side": "right",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 18,
      "text": "Strike forward with your right backfist.",
      "start": 96.466102,
      "end": 98.780161,
      "turn": null,
      "kihap": false
    },
    {
      "index": 19,
      "text": "Turn right into a horse stance. Sweep your left arm down for a low block.",
      "start": 100.247125,
      "end": 104.430164,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 20,
      "text": "Strike forward with your left backfist.",
      "start": 106.253123,
      "end": 108.556162,
      "turn": null,
      "kihap": false
    },
    {
      "index": 21,
      "text": "Turn right into a back stance. Strike across with the edge of your right hand. Finish with a strong shout.",
      "start": 110.021026,
      "end": 116.213089,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": true
    },
    {
      "index": 22,
      "text": "Chamber your left knee, then extend a roundhouse kick.",
      "start": 118.418721,
      "end": 121.569787,
      "turn": null,
      "kihap": false
    },
    {
      "index": 23,
      "text": "Land in a back stance. Block with your left forearm, supported by the other hand.",
      "start": 123.19618,
      "end": 128.0072,
      "turn": null,
      "kihap": false
    },
    {
      "index": 24,
      "text": "Return to the ready position.",
      "start": 130.049776,
      "end": 131.713858,
      "turn": null,
      "kihap": false
