  "cues": [
    {
      "index": 0,
      "text": "Stand ready, with your hands held in front.",
      "start": 0.12,
      "end": 2.159002267573696,
      "turn": null,
      "kihap": false
    },
    {
      "index": 1,
      "text": "Turn left into a front stance. Sweep your left arm down for a low block.",
      "start": 2.539002,
      "end": 7.361043,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 2,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 9.305718,
      "end": 12.212747,
      "turn": null,
      "kihap": false
    },
    {
      "index": 3,
      "text": "Land in a back stance. Move your left forearm outward to block.",
      "start": 13.792658,
      "end": 18.057737,
      "turn": null,
      "kihap": false
    },
    {
      "index": 4,
      "text": "Turn right into a front stance. Sweep your right arm down for a low block.",
      "start": 19.896324,
      "end": 24.568387,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 5,
      "text": "Chamber your left knee, then extend a front kick.",
      "start": 26.484495,
      "end": 29.425538,
      "turn": null,
      "kihap": false
    },
    {
      "index": 6,
      "text": "Land in a back stance. Move your right forearm outward to block.",
      "start": 31.011927,
      "end": 34.986984,
      "turn": null,
      "kihap": false
    },
    {
      "index": 7,
      "text": "Turn left into a front stance. Raise your right knifehand above your head to block.",
      "start": 36.770328,
      "end": 41.742391,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 8,
      "text": "Chamber your right knee, then extend a roundhouse kick.",
      "start": 43.715642,
      "end": 46.726708,
      "turn": null,
      "kihap": false
    },
    {
      "index": 9,
      "text": "Turn left into a front stance. Raise your left forearm outward into a high block.",
      "start": 48.326435,
      "end": 53.39546,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 10,
      "text": "Punch to the middle with your right fist.",
      "start": 55.387179,
      "end": 57.284231,
      "turn": null,
      "kihap": false
    },
    {
      "index": 11,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 58.937179,
      "end": 61.844208,
      "turn": null,
      "kihap": false
    },
    {
      "index": 12,
      "text": "Land in a front stance. Punch to the middle with your left fist.",
      "start": 63.424119,
      "end": 67.178178,
      "turn": null,
      "kihap": false
    },
    {
      "index": 13,
      "text": "Turn right into a front stance. Raise your right forearm outward into a high block.",
      "start": 68.919427,
      "end": 73.602466,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 14,
      "text": "Punch to the middle with your left fist.",
      "start": 75.520663,
      "end": 77.730731,
      "turn": null,
      "kihap": false
    },
    {
      "index": 15,
      "text": "Chamber your left knee, then extend a front kick.",
      "start": 79.177887,
      "end": 82.11893,
      "turn": null,
      "kihap": false
    },
    {
      "index": 16,
      "text": "Land in a front stance. Punch to the middle with your right fist.",
      "start": 83.705319,
      "end": 87.73838,
      "turn": null,
      "kihap": false
    },
    {
      "index": 17,
      "text": "Turn left into a parallel stance. Spread both forearms outward at a low level.",
      "start": 89.532773,
      "end": 94.308827,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 18,
      "text": "Set a front stance. Raise your left knifehand above your head to block.",
      "start": 95.258827,
      "end": 99.314881,
      "turn": null,
      "kihap": false
    },
    {
      "index": 19,
      "text": "Chamber your left knee, then extend a roundhouse kick. Finish with a strong shout.",
      "start": 101.113654,
      "end": 106.121681,
      "turn": null,
      "kihap": true
    },
    {
      "index": 20,
      "text": "Turn left into a front stance. Sweep your right arm down for a low block.",
      "start": 108.101782,
      "end": 112.587814,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 21,
      "text": "Chamber your left knee, then extend a front kick.",
      "start": 114.468486,
      "end": 117.409529,
      "turn": null,
      "kihap": false
    },
    {
      "index": 22,
      "text": "Land in a back stance. Move your right forearm outward to block.",
      "start": 118.995918,
      "end": 122.970975,
      "turn": null,
      "kihap": false
    },
    {
      "index": 23,
      "text": "Turn right into a front stance. Sweep your left arm down for a low block.",
      "start": 124.754319,
      "end": 129.123344,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 24,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 130.98173,
      "end": 133.888759,
      "turn": null,
      "kihap": false
    },
    {
      "index": 25,
      "text": "Land in a back stance. Move your left forearm outward to block.",
      "start": 135.46867,
      "end": 139.733749,
      "turn": null,
      "kihap": false
    },
    {
      "index": 26,
      "text": "Turn left into a back stance. Extend the front knifehand while the other hand guards your body.",
      "start": 141.572336,
      "end": 147.301361,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 27,
      "text": "Set a back stance. Extend the front knifehand while the other hand guards your body.",
      "start": 149.418794,
      "end": 154.263828,
      "turn": null,
      "kihap": false
    },
    {
      "index": 28,
      "text": "Set a front stance. Press the attack away with your left palm.",
      "start": 156.212882,
      "end": 159.850887,
      "turn": null,
      "kihap": false
    },
    {
      "index": 29,
      "text": "Punch to the middle with your right fist.",
      "start": 161.57003,
      "end": 163.467082,
      "turn": null,
      "kihap": false
    },
    {
      "index": 30,
      "text": "Set a front stance. Press the attack away with your right palm.",
      "start": 165.12003,
      "end": 168.584066,
      "turn": null,
      "kihap": false
    },
    {
      "index": 31,
      "text": "Punch to the middle with your left fist.",
      "start": 170.270073,
      "end": 172.480141,
      "turn": null,
