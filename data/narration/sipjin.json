  "cues": [
    {
      "index": 0,
      "text": "Stand ready, with your hands held in front.",
      "start": 0.12,
      "end": 2.159002267573696,
      "turn": null,
      "kihap": false
    },
    {
      "index": 1,
      "text": "Bring both forearms up to guard above your head.",
      "start": 2.539002,
      "end": 5.352063,
      "turn": null,
      "kihap": false
    },
    {
      "index": 2,
      "text": "Set a back stance. Block outward with your left forearm and support it with your palm.",
      "start": 11.914075,
      "end": 17.061104,
      "turn": null,
      "kihap": false
    },
    {
      "index": 3,
      "text": "Set a front stance. Turn your left wrist to change the hand position.",
      "start": 19.067682,
      "end": 23.436707,
      "turn": null,
      "kihap": false
    },
    {
      "index": 4,
      "text": "Thrust your right fingertips forward with the other hand supporting.",
      "start": 25.295093,
      "end": 29.026159,
      "turn": null,
      "kihap": false
    },
    {
      "index": 5,
      "text": "Punch to the middle with your left fist.",
      "start": 30.763028,
      "end": 32.973096,
      "turn": null,
      "kihap": false
    },
    {
      "index": 6,
      "text": "Punch to the middle with your right fist.",
      "start": 34.420252,
      "end": 36.317304,
      "turn": null,
      "kihap": false
    },
    {
      "index": 7,
      "text": "Set a horse stance. Open both arms outward into the mountain block.",
      "start": 37.970252,
      "end": 42.223313,
      "turn": null,
      "kihap": false
    },
    {
      "index": 8,
      "text": "Set a cross stance. Reach out with your left hand to prepare the next strike.",
      "start": 44.059611,
      "end": 49.136663,
      "turn": null,
      "kihap": false
    },
    {
      "index": 9,
      "text": "Punch out to the side with your right fist. Finish with a strong shout.",
      "start": 51.129911,
      "end": 55.278936,
      "turn": null,
      "kihap": true
    },
    {
      "index": 10,
      "text": "Turn left into a horse stance. Drive both elbows outward to the sides.",
      "start": 57.095417,
      "end": 61.813467,
      "turn": {
        "side": "left",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 11,
      "text": "Set a back stance. Block outward with your right forearm and support it with your palm.",
      "start": 63.738334,
      "end": 68.595386,
      "turn": null,
      "kihap": false
    },
    {
      "index": 12,
      "text": "Set a front stance. Turn your right wrist to change the hand position.",
      "start": 70.546729,
      "end": 74.439745,
      "turn": null,
      "kihap": false
    },
    {
      "index": 13,
      "text": "Thrust your left fingertips forward with the other hand supporting.",
      "start": 76.207462,
      "end": 79.416532,
      "turn": null,
      "kihap": false
    },
    {
      "index": 14,
      "text": "Punch to the middle with your right fist.",
      "start": 81.053974,
      "end": 82.951026,
      "turn": null,
      "kihap": false
    },
    {
      "index": 15,
      "text": "Punch to the middle with your left fist.",
      "start": 84.603974,
      "end": 86.814042,
      "turn": null,
      "kihap": false
    },
    {
      "index": 16,
      "text": "Set a horse stance. Open both arms outward into the mountain block.",
      "start": 88.261198,
      "end": 92.514259,
      "turn": null,
      "kihap": false
    },
    {
      "index": 17,
      "text": "Set a cross stance. Reach out with your right hand to prepare the next strike.",
      "start": 94.350557,
      "end": 98.441577,
      "turn": null,
      "kihap": false
    },
    {
      "index": 18,
      "text": "Punch out to the side with your left fist. Finish with a strong shout.",
      "start": 100.24701,
      "end": 104.082067,
      "turn": null,
      "kihap": true
    },
    {
      "index": 19,
      "text": "Turn right into a horse stance. Drive both elbows outward to the sides.",
      "start": 105.838744,
      "end": 110.230807,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 20,
      "text": "Set a back stance. Block outward with your right forearm and support it with your palm.",
      "start": 112.093581,
      "end": 116.950633,
      "turn": null,
      "kihap": false
    },
    {
      "index": 21,
      "text": "Set a front stance. Turn your right wrist to change the hand position.",
      "start": 118.901976,
      "end": 122.794992,
      "turn": null,
      "kihap": false
    },
    {
      "index": 22,
      "text": "Thrust your left fingertips forward with the other hand supporting.",
      "start": 124.562709,
      "end": 127.771779,
      "turn": null,
      "kihap": false
    },
    {
      "index": 23,
      "text": "Punch to the middle with your right fist.",
      "start": 129.409221,
      "end": 131.306273,
      "turn": null,
      "kihap": false
    },
    {
      "index": 24,
      "text": "Punch to the middle with your left fist.",
      "start": 132.959221,
      "end": 135.169289,
      "turn": null,
      "kihap": false
    },
    {
      "index": 25,
      "text": "Set a back stance. Lower the front knifehand while the other hand guards your body.",
      "start": 136.616445,
      "end": 141.461479,
      "turn": null,
      "kihap": false
    },
    {
      "index": 26,
      "text": "Set a front stance. Push both palms forward and upward at a steady pace.",
      "start": 143.410533,
      "end": 148.349581,
      "turn": null,
      "kihap": false
    },
    {
      "index": 27,
      "text": "Turn left into a horse stance. Open both ridgehands outward to block.",
      "start": 154.299581,
      "end": 158.958629,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 28,
      "text": "Spread both open hands outward into the low block.",
      "start": 160.872257,
      "end": 163.929309,
      "turn": null,
      "kihap": false
    },
    {
      "index": 29,
      "text": "Spread both forearms outward at a low level.",
      "start": 170.537795,
      "end": 173.269813,
      "turn": null,
      "kihap": false
    },
    {
      "index": 30,
      "text": "Turn left into a front stance. Lift your left forearm upward to redirect the attack.",
      "start": 179.816388,
      "end": 184.836433,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 31,
      "text": "Push both palms forward and upward at a steady pace.",
      "start": 186.818823,
      "end": 189.957871,
      "turn": null,
      "kihap": false
    },
    {
      "index": 32,
      "text": "Set a front stance. Draw both fists back together beside your hip.",
      "start": 195.907871,
      "end": 199.905921,
      "turn": null,
      "kihap": false
    },
    {
      "index": 33,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 201.693645,
      "end": 204.600674,
      "turn": null,
      "kihap": false
    },
    {
      "index": 34,
      "text": "Land in a front stance. Punch forward with one fist high and the other low.",
      "start": 206.180585,
      "end": 210.654644,
      "turn": null,
      "kihap": false
    },
    {
      "index": 35,
      "text": "Set a front stance. Draw both fists back together beside your hip.",
      "start": 212.533036,
      "end": 216.531086,
      "turn": null,
      "kihap": false
    },
    {
      "index": 36,
      "text": "Chamber your left knee, then extend a front kick.",
      "start": 218.31881,
      "end": 221.259853,
      "turn": null,
      "kihap": false
    },
    {
      "index": 37,
      "text": "Land in a front stance. Punch forward with one fist high and the other low.",
      "start": 222.846242,
      "end": 227.320301,
      "turn": null,
      "kihap": false
    },
    {
      "index": 38,
      "text": "Set a cross stance. Draw both fists back together beside your hip.",
      "start": 229.198693,
      "end": 233.439736,
      "turn": null,
      "kihap": false
    },
    {
      "index": 39,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 235.273744,
      "end": 238.180773,
      "turn": null,
      "kihap": false
    },
    {
      "index": 40,
      "text": "Land in a cross stance. Strike with your right backfist while the other hand supports. Finish with a strong shout.",
      "start": 239.760684,
      "end": 246.580729,
      "turn": null,
      "kihap": true
    },
    {
      "index": 41,
      "text": "Turn left into a front stance. Push both palms forward and upward at a steady pace.",
      "start": 248.905976,
      "end": 254.204026,
      "turn": {
        "side": "left",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 42,
      "text": "Set a cat stance. Cross both open hands in front for a low block.",
      "start": 260.154026,
      "end": 264.41906,
      "turn": null,
      "kihap": false
    },
    {
      "index": 43,
      "text": "Set a back stance. Form a guarding position with both open ridgehands.",
      "start": 266.257638,
      "end": 270.452695,
      "turn": null,
      "kihap": false
    },
    {
      "index": 44,
      "text": "Set a back stance. Punch forward with one fist high and the other low.",
      "start": 272.277944,
      "end": 276.333998,
      "turn": null,
      "kihap": false
    },
    {
      "index": 45,
      "text": "Set a back stance. Punch forward with one fist high and the other low.",
      "start": 278.132771,
      "end": 282.188825,
      "turn": null,
      "kihap": false
    },
    {
      "index": 46,
      "text": "Return to the ready position.",
      "start": 284.087598,
      "end": 285.75168,
      "turn": null,
      "kihap": false
    }
  ],
