  "cues": [
    {
      "index": 0,
      "text": "Stand ready, with your hands held in front.",
      "start": 0.12,
      "end": 2.159002267573696,
      "turn": null,
      "kihap": false
    },
    {
      "index": 1,
      "text": "Set a back stance. Strike across with the edge of your left hand.",
      "start": 2.539002,
      "end": 6.270068,
      "turn": null,
      "kihap": false
    },
    {
      "index": 2,
      "text": "Extend the front knifehand while the other hand guards your body.",
      "start": 8.006938,
      "end": 11.295963,
      "turn": null,
      "kihap": false
    },
    {
      "index": 3,
      "text": "Chamber your right knee, then extend a front kick.",
