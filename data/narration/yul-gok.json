  "cues": [
    {
      "index": 0,
      "text": "Stand ready, with your hands held in front.",
      "start": 0.12,
      "end": 2.159002267573696,
      "turn": null,
      "kihap": false
    },
    {
      "index": 1,
      "text": "Set a horse stance. Extend your left arm to measure the target distance.",
      "start": 2.539002,
      "end": 6.804036,
      "turn": null,
      "kihap": false
    },
    {
      "index": 2,
      "text": "Punch to the middle with your right fist.",
      "start": 7.754036,
      "end": 9.651088,
      "turn": null,
      "kihap": false
    },
    {
      "index": 3,
      "text": "Punch to the middle with your left fist.",
      "start": 11.304036,
      "end": 13.514104,
      "turn": null,
      "kihap": false
    },
    {
      "index": 4,
      "text": "Extend your right arm to measure the target distance.",
      "start": 14.96126,
      "end": 17.833278,
      "turn": null,
      "kihap": false
    },
    {
      "index": 5,
      "text": "Punch to the middle with your left fist.",
      "start": 18.783278,
      "end": 20.993346,
      "turn": null,
      "kihap": false
    },
    {
      "index": 6,
      "text": "Punch to the middle with your right fist.",
      "start": 22.440502,
      "end": 24.337554,
      "turn": null,
      "kihap": false
    },
    {
      "index": 7,
      "text": "Turn right into a walking stance. Block outward with your right inner forearm.",
      "start": 25.990502,
      "end": 31.033586,
      "turn": {
        "side": "right",
        "degrees": 45
      },
      "kihap": false
    },
    {
      "index": 8,
      "text": "Chamber your left knee, then extend a low front kick.",
      "start": 33.020364,
      "end": 35.9044,
      "turn": null,
      "kihap": false
    },
    {
      "index": 9,
      "text": "Land in a walking stance. Punch to the middle with your left fist.",
      "start": 37.479931,
      "end": 42.069999,
      "turn": null,
      "kihap": false
    },
    {
      "index": 10,
      "text": "Punch to the middle with your right fist.",
      "start": 43.970488,
      "end": 45.86754,
      "turn": null,
      "kihap": false
    },
    {
      "index": 11,
      "text": "Turn left into a walking stance. Block outward with your left inner forearm.",
      "start": 47.520488,
      "end": 52.156497,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 12,
      "text": "Chamber your right knee, then extend a low front kick.",
      "start": 54.065737,
      "end": 57.134807,
      "turn": null,
      "kihap": false
    },
    {
      "index": 13,
      "text": "Land in a walking stance. Punch to the middle with your right fist.",
      "start": 58.745583,
      "end": 63.451615,
      "turn": null,
      "kihap": false
    },
    {
      "index": 14,
      "text": "Punch to the middle with your left fist.",
      "start": 65.374192,
      "end": 67.58426,
      "turn": null,
      "kihap": false
    },
    {
      "index": 15,
      "text": "Turn right into a walking stance. Hook and redirect with your open right hand.",
      "start": 69.031416,
      "end": 74.051461,
      "turn": {
        "side": "right",
        "degrees": 45
      },
      "kihap": false
    },
    {
      "index": 16,
      "text": "Hook and redirect with your open left hand.",
      "start": 75.001461,
      "end": 77.641506,
      "turn": null,
      "kihap": false
    },
    {
      "index": 17,
      "text": "Punch to the middle with your right fist.",
      "start": 80.551461,
      "end": 82.448513,
      "turn": null,
      "kihap": false
    },
    {
      "index": 18,
      "text": "Set a walking stance. Hook and redirect with your open left hand.",
      "start": 84.101461,
      "end": 88.157515,
      "turn": null,
      "kihap": false
    },
    {
      "index": 19,
      "text": "Hook and redirect with your open right hand.",
      "start": 89.651461,
      "end": 92.406518,
      "turn": null,
      "kihap": false
    },
    {
      "index": 20,
      "text": "Punch to the middle with your left fist.",
      "start": 95.201461,
      "end": 97.411529,
      "turn": null,
      "kihap": false
    },
    {
      "index": 21,
      "text": "Set a walking stance. Punch to the middle with your right fist.",
      "start": 98.858685,
      "end": 102.415737,
      "turn": null,
      "kihap": false
    },
    {
      "index": 22,
      "text": "Chamber your left leg beside the supporting knee.",
      "start": 104.119461,
      "end": 106.933475,
      "turn": null,
      "kihap": false
    },
    {
      "index": 23,
      "text": "Chamber your left knee, then extend a side kick.",
      "start": 107.883475,
      "end": 110.604518,
      "turn": null,
      "kihap": false
    },
    {
      "index": 24,
      "text": "Land in a walking stance. Drive your right elbow toward the opposite open palm.",
      "start": 112.149002,
      "end": 116.843061,
      "turn": null,
      "kihap": false
    },
    {
      "index": 25,
      "text": "Turn left into a one-leg stance. Chamber your right leg beside the supporting knee.",
      "start": 118.763358,
      "end": 123.818369,
      "turn": {
        "side": "left",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 26,
      "text": "Chamber your right knee, then extend a side kick.",
      "start": 124.768369,
      "end": 127.535444,
      "turn": null,
      "kihap": false
    },
    {
      "index": 27,
      "text": "Land in a walking stance. Drive your left elbow toward the opposite open palm.",
      "start": 129.088696,
      "end": 133.56271,
      "turn": null,
      "kihap": false
    },
    {
      "index": 28,
      "text": "Turn left into a back stance. Form the twin knifehand guard with both open hands.",
      "start": 135.441093,
      "end": 140.310118,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 29,
      "text": "Set a walking stance. Thrust your right fingertips forward with the other hand supporting.",
      "start": 142.263742,
      "end": 147.469819,
      "turn": null,
      "kihap": false
    },
    {
      "index": 30,
      "text": "Turn right into a back stance. Form the twin knifehand guard with both open hands.",
      "start": 149.487643,
      "end": 154.274672,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 31,
      "text": "Set a walking stance. Thrust your left fingertips forward with the other hand supporting.",
      "start": 156.212678,
      "end": 160.977712,
      "turn": null,
      "kihap": false
    },
    {
      "index": 32,
      "text": "Turn left into a walking stance. Move your left forearm outward to block.",
      "start": 162.911528,
      "end": 168.105587,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 33,
      "text": "Punch to the middle with your right fist.",
      "start": 170.121122,
      "end": 172.018174,
      "turn": null,
      "kihap": false
    },
    {
      "index": 34,
      "text": "Set a walking stance. Move your right forearm outward to block.",
      "start": 173.671122,
      "end": 177.645136,
      "turn": null,
      "kihap": false
    },
    {
      "index": 35,
      "text": "Punch to the middle with your left fist.",
      "start": 179.428281,
      "end": 181.638349,
      "turn": null,
      "kihap": false
    },
    {
      "index": 36,
      "text": "Turn right into a cross stance. Strike forward with your left backfist.",
      "start": 183.085505,
      "end": 187.74555,
      "turn": {
        "side": "right",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 37,
      "text": "Turn right into a walking stance. Block with your right forearm, supported by the other hand.",
      "start": 189.659369,
      "end": 195.131387,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 38,
      "text": "Turn left into a walking stance. Block with your left forearm, supported by the other hand.",
      "start": 197.199867,
      "end": 202.625899,
      "turn": {
        "side": "left",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 39,
      "text": "Return to the ready position.",
      "start": 204.785619,
      "end": 206.449701,
      "turn": null,
      "kihap": false
