  "cues": [
    {
      "index": 0,
      "text": "Stand ready, with your hands held in front.",
      "start": 0.12,
      "end": 2.159002267573696,
      "turn": null,
      "kihap": false
    },
    {
      "index": 1,
      "text": "Turn left into a front stance. Sweep your left arm down for a low block.",
      "start": 2.539002,
      "end": 7.361043,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 2,
      "text": "Set a parallel stance. Strike down with your left hammerfist.",
      "start": 9.305718,
      "end": 12.931795,
      "turn": null,
      "kihap": false
    },
    {
      "index": 3,
      "text": "Turn right into a front stance. Sweep your right arm down for a low block.",
      "start": 14.648667,
      "end": 19.32073,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 4,
      "text": "Set a parallel stance. Strike down with your right hammerfist.",
      "start": 21.236838,
      "end": 25.152892,
      "turn": null,
      "kihap": false
    },
    {
      "index": 5,
      "text": "Turn left into a front stance. Sweep your left forearm inward across your body.",
      "start": 26.924998,
      "end": 31.817061,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 6,
      "text": "Sweep your right forearm inward across your body.",
      "start": 33.775074,
      "end": 36.693124,
      "turn": null,
      "kihap": false
    },
    {
      "index": 7,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 38.275133,
      "end": 41.182162,
      "turn": null,
      "kihap": false
    },
    {
      "index": 8,
      "text": "Land in a front stance. Strike forward with your right backfist.",
      "start": 42.762073,
      "end": 46.945112,
      "turn": null,
      "kihap": false
    },
    {
      "index": 9,
      "text": "Sweep your left forearm inward across your body.",
      "start": 48.768071,
      "end": 51.58213,
      "turn": null,
      "kihap": false
    },
    {
      "index": 10,
      "text": "Chamber your left knee, then extend a front kick.",
      "start": 53.144332,
      "end": 56.085375,
      "turn": null,
      "kihap": false
    },
    {
      "index": 11,
      "text": "Land in a front stance. Strike forward with your left backfist.",
      "start": 57.671764,
      "end": 61.739837,
      "turn": null,
      "kihap": false
    },
    {
      "index": 12,
      "text": "Sweep your right forearm inward across your body.",
      "start": 63.540898,
      "end": 66.458948,
      "turn": null,
      "kihap": false
    },
    {
      "index": 13,
      "text": "Set a front stance. Strike forward with your right backfist.",
      "start": 68.040957,
      "end": 71.737011,
      "turn": null,
      "kihap": false
    },
    {
      "index": 14,
      "text": "Turn left into a back stance. Extend your left knifehand to block.",
      "start": 73.467212,
      "end": 77.860228,
      "turn": {
        "side": "left",
        "degrees": 270
      },
      "kihap": false
    },
    {
      "index": 15,
      "text": "Set a front stance. Drive your right elbow toward the opposite open palm.",
      "start": 79.723183,
      "end": 83.953206,
      "turn": null,
      "kihap": false
    },
    {
      "index": 16,
      "text": "Turn right into a back stance. Extend your right knifehand to block.",
      "start": 85.785115,
      "end": 89.887156,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 17,
      "text": "Set a front stance. Drive your left elbow toward the opposite open palm.",
      "start": 91.694687,
      "end": 96.180764,
      "turn": null,
      "kihap": false
    },
    {
      "index": 18,
      "text": "Turn left into a front stance. Sweep your left arm down for a low block.",
      "start": 98.061445,
      "end": 102.883486,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 19,
      "text": "Sweep your right forearm inward across your body.",
      "start": 104.82816,
      "end": 107.74621,
      "turn": null,
      "kihap": false
    },
    {
      "index": 20,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 109.328219,
      "end": 112.235248,
      "turn": null,
      "kihap": false
    },
    {
      "index": 21,
      "text": "Land in a front stance. Sweep your right arm down for a low block.",
      "start": 113.815159,
      "end": 118.069173,
      "turn": null,
      "kihap": false
    },
    {
      "index": 22,
      "text": "Sweep your left forearm inward across your body.",
      "start": 119.905651,
      "end": 122.71971,
      "turn": null,
      "kihap": false
    },
    {
      "index": 23,
      "text": "Turn left into a front stance. Raise your left forearm above your head to block.",
      "start": 124.281912,
      "end": 129.092978,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 24,
      "text": "Chamber your right knee, then extend a side kick.",
      "start": 131.035562,
      "end": 133.802637,
      "turn": null,
      "kihap": false
    },
    {
      "index": 25,
      "text": "Land in a front stance. Drive your left elbow toward the opposite open palm.",
      "start": 135.355889,
      "end": 140.246909,
      "turn": null,
      "kihap": false
    },
    {
      "index": 26,
      "text": "Turn right into a front stance. Raise your right forearm above your head to block.",
      "start": 142.204723,
      "end": 147.130755,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 27,
      "text": "Chamber your left knee, then extend a side kick.",
      "start": 149.095237,
      "end": 151.81628,
      "turn": null,
      "kihap": false
    },
    {
      "index": 28,
      "text": "Land in a front stance. Drive your right elbow toward the opposite open palm.",
      "start": 153.360764,
      "end": 158.171784,
      "turn": null,
      "kihap": false
    },
    {
      "index": 29,
      "text": "Turn left into a front stance. Sweep your left arm down for a low block.",
      "start": 160.11436,
      "end": 164.936401,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 30,
      "text": "Sweep your right forearm inward across your body.",
      "start": 166.881075,
      "end": 169.799125,
      "turn": null,
      "kihap": false
    },
    {
      "index": 31,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 171.381134,
      "end": 174.288163,
      "turn": null,
      "kihap": false
    },
    {
      "index": 32,
      "text": "Land in a cross stance. Strike forward with your right backfist. Finish with a strong shout.",
      "start": 175.868074,
      "end": 181.898142,
      "turn": null,
      "kihap": true
    },
    {
      "index": 33,
