  "cues": [
    {
      "index": 0,
      "text": "Stand ready, with your hands held in front.",
      "start": 0.12,
      "end": 2.159002267573696,
      "turn": null,
      "kihap": false
    },
    {
      "index": 1,
      "text": "Turn left into a front stance. Sweep your left arm down for a low block.",
      "start": 2.539002,
      "end": 7.361043,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 2,
      "text": "Set a parallel stance. Strike down with your left hammerfist.",
      "start": 9.305718,
      "end": 12.931795,
      "turn": null,
      "kihap": false
    },
    {
      "index": 3,
      "text": "Turn right into a front stance. Sweep your right arm down for a low block.",
      "start": 14.648667,
      "end": 19.32073,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 4,
      "text": "Set a parallel stance. Strike down with your right hammerfist.",
      "start": 21.236838,
      "end": 25.152892,
      "turn": null,
      "kihap": false
    },
    {
      "index": 5,
      "text": "Turn left into a front stance. Sweep your left forearm inward across your body.",
      "start": 26.924998,
      "end": 31.817061,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 6,
      "text": "Sweep your right forearm inward across your body.",
      "start": 33.775074,
      "end": 36.693124,
      "turn": null,
      "kihap": false
    },
    {
      "index": 7,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 38.275133,
      "end": 41.182162,
      "turn": null,
      "kihap": false
    },
    {
      "index": 8,
      "text": "Land in a front stance. Strike forward with your right backfist.",
      "start": 42.762073,
      "end": 46.945112,
      "turn": null,
      "kihap": false
    },
    {
      "index": 9,
      "text": "Sweep your left forearm inward across your body.",
      "start": 48.768071,
      "end": 51.58213,
      "turn": null,
      "kihap": false
    },
    {
      "index": 10,
      "text": "Chamber your left knee, then extend a front kick.",
      "start": 53.144332,
      "end": 56.085375,
      "turn": null,
      "kihap": false
    },
    {
      "index": 11,
      "text": "Land in a front stance. Strike forward with your left backfist.",
      "start": 57.671764,
      "end": 61.739837,
      "turn": null,
      "kihap": false
    },
    {
      "index": 12,
      "text": "Sweep your right forearm inward across your body.",
      "start": 63.540898,
      "end": 66.458948,
      "turn": null,
      "kihap": false
    },
    {
      "index": 13,
      "text": "Set a front stance. Strike forward with your right backfist.",
      "start": 68.040957,
      "end": 71.737011,
      "turn": null,
      "kihap": false
    },
    {
      "index": 14,
      "text": "Make a three-quarter turn to your left, then set a back stance. Extend your left knifehand to block.",
      "start": 73.467212,
      "end": 79.299275,
      "turn": {
        "side": "left",
        "degrees": 270
      },
      "kihap": false
    },
    {
      "index": 15,
      "text": "Set a front stance. Drive your right elbow toward the opposite open palm.",
      "start": 81.436335,
      "end": 85.666358,
      "turn": null,
      "kihap": false
    },
    {
      "index": 16,
      "text": "Turn right into a back stance. Extend your right knifehand to block.",
      "start": 87.498267,
      "end": 91.600308,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 17,
      "text": "Set a front stance. Drive your left elbow toward the opposite open palm.",
      "start": 93.407839,
      "end": 97.893916,
      "turn": null,
      "kihap": false
    },
    {
      "index": 18,
      "text": "Turn left into a front stance. Sweep your left arm down for a low block.",
      "start": 99.774597,
      "end": 104.596638,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 19,
      "text": "Sweep your right forearm inward across your body.",
      "start": 106.541312,
      "end": 109.459362,
      "turn": null,
      "kihap": false
    },
    {
      "index": 20,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 111.041371,
      "end": 113.9484,
      "turn": null,
      "kihap": false
    },
    {
      "index": 21,
      "text": "Land in a front stance. Sweep your right arm down for a low block.",
      "start": 115.528311,
      "end": 119.782325,
      "turn": null,
      "kihap": false
    },
    {
      "index": 22,
      "text": "Sweep your left forearm inward across your body.",
      "start": 121.618803,
      "end": 124.432862,
      "turn": null,
      "kihap": false
    },
    {
      "index": 23,
      "text": "Turn left into a front stance. Raise your left forearm above your head to block.",
      "start": 125.995064,
      "end": 130.80613,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 24,
      "text": "Chamber your right knee, then extend a side kick.",
      "start": 132.748714,
      "end": 135.515789,
      "turn": null,
      "kihap": false
    },
    {
      "index": 25,
      "text": "Land in a front stance. Drive your left elbow toward the opposite open palm.",
      "start": 137.069041,
      "end": 141.960061,
      "turn": null,
      "kihap": false
    },
    {
      "index": 26,
      "text": "Turn right into a front stance. Raise your right forearm above your head to block.",
      "start": 143.917875,
      "end": 148.843907,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 27,
      "text": "Chamber your left knee, then extend a side kick.",
      "start": 150.808389,
      "end": 153.529432,
      "turn": null,
      "kihap": false
    },
    {
      "index": 28,
      "text": "Land in a front stance. Drive your right elbow toward the opposite open palm.",
      "start": 155.073916,
      "end": 159.884936,
      "turn": null,
      "kihap": false
    },
    {
      "index": 29,
      "text": "Turn left into a front stance. Sweep your left arm down for a low block.",
      "start": 161.827512,
      "end": 166.649553,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 30,
      "text": "Sweep your right forearm inward across your body.",
      "start": 168.594227,
      "end": 171.512277,
      "turn": null,
      "kihap": false
    },
    {
      "index": 31,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 173.094286,
      "end": 176.001315,
      "turn": null,
      "kihap": false
    },
    {
      "index": 32,
      "text": "Land in a cross stance. Strike forward with your right backfist. Finish with a strong shout.",
      "start": 177.581226,
      "end": 183.611294,
      "turn": null,
      "kihap": true
    },
    {
      "index": 33,
      "text": "Return to the ready position.",
      "start": 185.886069,
      "end": 187.550151,
      "turn": null,
      "kihap": false
    }
  ],
