  "cues": [
    {
      "index": 0,
      "text": "Stand ready, with your hands held in front.",
      "start": 0.12,
      "end": 2.159002267573696,
      "turn": null,
      "kihap": false
    },
    {
      "index": 1,
      "text": "Set a cat stance. Spread both open hands outward into the low block.",
      "start": 2.539002,
      "end": 7.19805,
      "turn": null,
      "kihap": false
    },
    {
      "index": 2,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 9.111678,
      "end": 12.018707,
      "turn": null,
      "kihap": false
    },
    {
      "index": 3,
      "text": "Land in a front stance. Punch to the middle with your right fist.",
      "start": 13.598618,
      "end": 17.631679,
      "turn": null,
      "kihap": false
    },
    {
      "index": 4,
      "text": "Punch to the middle with your left fist.",
      "start": 19.426072,
      "end": 21.63614,
      "turn": null,
      "kihap": false
    },
    {
      "index": 5,
      "text": "Turn right into a cat stance. Spread both open hands outward into the low block.",
      "start": 23.083296,
      "end": 28.358307,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 6,
      "text": "Chamber your left knee, then extend a front kick.",
      "start": 30.389262,
      "end": 33.330305,
      "turn": null,
      "kihap": false
    },
    {
      "index": 7,
      "text": "Land in a front stance. Punch to the middle with your left fist.",
      "start": 34.916694,
      "end": 38.670753,
      "turn": null,
      "kihap": false
    },
    {
      "index": 8,
      "text": "Punch to the middle with your right fist.",
      "start": 40.412002,
      "end": 42.309054,
      "turn": null,
      "kihap": false
    },
    {
      "index": 9,
      "text": "Turn left into a front stance. Raise your left knifehand above your head to block. Strike across with the edge of your right hand.",
      "start": 43.962002,
      "end": 51.559054,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 10,
      "text": "Set a front stance. Press the attack away with your right palm.",
      "start": 54.032302,
      "end": 57.496338,
      "turn": null,
      "kihap": false
    },
    {
      "index": 11,
      "text": "Punch to the middle with your left fist.",
      "start": 59.182345,
      "end": 61.392413,
      "turn": null,
      "kihap": false
    },
    {
      "index": 12,
      "text": "Set a front stance. Press the attack away with your left palm.",
      "start": 62.839569,
      "end": 66.477574,
      "turn": null,
      "kihap": false
    },
    {
      "index": 13,
      "text": "Punch to the middle with your right fist.",
      "start": 68.196717,
      "end": 70.093769,
      "turn": null,
      "kihap": false
    },
    {
      "index": 14,
      "text": "Set a front stance. Press the attack away with your right palm.",
      "start": 71.746717,
      "end": 75.210753,
      "turn": null,
      "kihap": false
    },
    {
      "index": 15,
      "text": "Punch to the middle with your left fist. Finish with a strong shout.",
      "start": 76.89676,
      "end": 80.882792,
      "turn": null,
      "kihap": true
    },
    {
      "index": 16,
      "text": "Turn left into a back stance. Set one forearm high and the other forward at the middle.",
      "start": 82.668226,
      "end": 87.862285,
      "turn": {
        "side": "left",
        "degrees": 270
      },
      "kihap": false
    },
    {
      "index": 17,
      "text": "Pull with one hand as your right fist rises in an uppercut.",
      "start": 89.87782,
      "end": 93.376868,
      "turn": null,
      "kihap": false
    },
    {
      "index": 18,
      "text": "Punch out to the side with your left fist.",
      "start": 95.069543,
      "end": 97.267593,
      "turn": null,
      "kihap": false
    },
    {
      "index": 19,
      "text": "Balance on your right leg. Draw both fists back together beside your hip.",
      "start": 98.71246,
      "end": 103.139535,
      "turn": null,
      "kihap": false
    },
    {
      "index": 20,
      "text": "Chamber your left knee, then extend a side kick. Punch out to the side with your left fist.",
      "start": 105.008978,
      "end": 110.539001,
      "turn": null,
      "kihap": false
    },
    {
      "index": 21,
      "text": "Land in a front stance. Drive your right elbow toward the opposite open palm.",
      "start": 112.618529,
      "end": 117.429549,
      "turn": null,
      "kihap": false
    },
    {
      "index": 22,
      "text": "Turn right into a closed stance. Draw both fists back together beside your hip.",
      "start": 119.372125,
      "end": 124.484188,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 23,
      "text": "Set one forearm high and the other forward at the middle.",
      "start": 126.484105,
      "end": 129.983153,
      "turn": null,
      "kihap": false
    },
    {
      "index": 24,
      "text": "Pull with one hand as your left fist rises in an uppercut.",
      "start": 131.675828,
      "end": 135.743855,
      "turn": null,
      "kihap": false
    },
    {
      "index": 25,
      "text": "Punch out to the side with your right fist.",
      "start": 137.544908,
      "end": 139.731937,
      "turn": null,
      "kihap": false
    },
    {
      "index": 26,
      "text": "Balance on your left leg. Draw both fists back together beside your hip.",
      "start": 141.174705,
      "end": 145.567766,
      "turn": null,
      "kihap": false
    },
    {
      "index": 27,
      "text": "Chamber your right knee, then extend a side kick. Punch out to the side with your right fist.",
      "start": 147.43073,
      "end": 152.705787,
      "turn": null,
      "kihap": false
    },
    {
      "index": 28,
      "text": "Land in a front stance. Drive your left elbow toward the opposite open palm.",
      "start": 154.73675,
      "end": 159.62777,
      "turn": null,
      "kihap": false
    },
    {
      "index": 29,
      "text": "Turn left into a closed stance. Draw both fists back together beside your hip.",
      "start": 161.585584,
      "end": 166.280641,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 30,
      "text": "Extend the front knifehand while the other hand guards your body.",
      "start": 168.201128,
      "end": 171.490153,
      "turn": null,
      "kihap": false
    },
    {
      "index": 31,
      "text": "Set a front stance. Press downward with your left palm. Thrust your right fingertips forward as the other hand blocks.",
      "start": 173.142824,
      "end": 180.437835,
      "turn": null,
      "kihap": false
    },
    {
      "index": 32,
      "text": "Turn all the way around to the left. Rotate and lift your right wrist to release the grip.",
      "start": 182.853552,
      "end": 188.082577,
      "turn": {
        "side": "left",
        "degrees": 360
      },
      "kihap": false
    },
    {
      "index": 33,
      "text": "Strike forward with your left backfist.",
      "start": 190.104772,
      "end": 192.407811,
      "turn": null,
      "kihap": false
    },
    {
      "index": 34,
      "text": "Set a front stance. Punch to the middle with your right fist. Finish with a strong shout.",
      "start": 193.872675,
      "end": 199.69272,
      "turn": null,
      "kihap": true
    },
    {
      "index": 35,
      "text": "Turn left into a front stance. Block outward with your left arm as the other arm blocks low.",
      "start": 201.827491,
      "end": 207.763545,
      "turn": {
        "side": "left",
        "degrees": 270
      },
      "kihap": false
    },
    {
