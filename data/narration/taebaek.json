  "cues": [
    {
      "index": 0,
      "text": "Stand ready, with your hands held in front.",
      "start": 0.12,
      "end": 2.159002267573696,
      "turn": null,
      "kihap": false
    },
    {
      "index": 1,
      "text": "Set a cat stance. Spread both open hands outward into the low block.",
      "start": 2.539002,
      "end": 7.19805,
      "turn": null,
      "kihap": false
    },
    {
      "index": 2,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 9.111678,
      "end": 12.018707,
      "turn": null,
      "kihap": false
    },
    {
      "index": 3,
      "text": "Land in a front stance. Punch to the middle with your right fist.",
      "start": 13.598618,
      "end": 17.631679,
      "turn": null,
      "kihap": false
    },
    {
      "index": 4,
      "text": "Punch to the middle with your left fist.",
      "start": 19.426072,
      "end": 21.63614,
      "turn": null,
      "kihap": false
    },
    {
      "index": 5,
      "text": "Turn right into a cat stance. Spread both open hands outward into the low block.",
      "start": 23.083296,
      "end": 28.358307,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 6,
      "text": "Chamber your left knee, then extend a front kick.",
      "start": 30.389262,
      "end": 33.330305,
      "turn": null,
      "kihap": false
    },
    {
      "index": 7,
      "text": "Land in a front stance. Punch to the middle with your left fist.",
      "start": 34.916694,
      "end": 38.670753,
      "turn": null,
      "kihap": false
    },
    {
      "index": 8,
      "text": "Punch to the middle with your right fist.",
      "start": 40.412002,
      "end": 42.309054,
      "turn": null,
      "kihap": false
    },
    {
      "index": 9,
      "text": "Turn left into a front stance. Raise your left knifehand above your head to block. Strike across with the edge of your right hand.",
      "start": 43.962002,
      "end": 51.559054,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 10,
      "text": "Set a front stance. Press the attack away with your right palm.",
      "start": 54.032302,
      "end": 57.496338,
      "turn": null,
      "kihap": false
    },
    {
      "index": 11,
      "text": "Punch to the middle with your left fist.",
      "start": 59.182345,
      "end": 61.392413,
      "turn": null,
      "kihap": false
    },
    {
      "index": 12,
      "text": "Set a front stance. Press the attack away with your left palm.",
      "start": 62.839569,
      "end": 66.477574,
      "turn": null,
      "kihap": false
    },
    {
      "index": 13,
      "text": "Punch to the middle with your right fist.",
      "start": 68.196717,
      "end": 70.093769,
      "turn": null,
      "kihap": false
    },
    {
      "index": 14,
      "text": "Set a front stance. Press the attack away with your right palm.",
      "start": 71.746717,
      "end": 75.210753,
      "turn": null,
      "kihap": false
    },
    {
      "index": 15,
      "text": "Punch to the middle with your left fist. Finish with a strong shout.",
      "start": 76.89676,
      "end": 80.882792,
      "turn": null,
      "kihap": true
    },
    {
      "index": 16,
      "text": "Make a three-quarter turn to your left, then set a back stance. Set one forearm high and the other forward at the middle.",
      "start": 82.668226,
      "end": 90.079292,
      "turn": {
        "side": "left",
        "degrees": 270
      },
      "kihap": false
    },
    {
      "index": 17,
      "text": "Pull with one hand as your right fist rises in an uppercut.",
      "start": 92.517114,
      "end": 96.016162,
      "turn": null,
      "kihap": false
    },
    {
      "index": 18,
      "text": "Punch out to the side with your left fist.",
      "start": 97.708837,
      "end": 99.906887,
      "turn": null,
      "kihap": false
    },
    {
      "index": 19,
      "text": "Balance on your right leg. Draw both fists back together beside your hip.",
      "start": 101.351754,
      "end": 105.778829,
      "turn": null,
      "kihap": false
    },
    {
      "index": 20,
      "text": "Chamber your left knee, then extend a side kick. Punch out to the side with your left fist.",
      "start": 107.648272,
      "end": 113.178295,
      "turn": null,
      "kihap": false
    },
    {
      "index": 21,
      "text": "Land in a front stance. Drive your right elbow toward the opposite open palm.",
      "start": 115.257823,
      "end": 120.068843,
      "turn": null,
      "kihap": false
    },
    {
      "index": 22,
      "text": "Turn right into a closed stance. Draw both fists back together beside your hip.",
      "start": 122.011419,
      "end": 127.123482,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 23,
      "text": "Set one forearm high and the other forward at the middle.",
      "start": 129.123399,
      "end": 132.622447,
      "turn": null,
      "kihap": false
    },
    {
      "index": 24,
      "text": "Pull with one hand as your left fist rises in an uppercut.",
      "start": 134.315122,
      "end": 138.383149,
      "turn": null,
      "kihap": false
    },
    {
      "index": 25,
      "text": "Punch out to the side with your right fist.",
      "start": 140.184202,
      "end": 142.371231,
      "turn": null,
      "kihap": false
    },
    {
      "index": 26,
      "text": "Balance on your left leg. Draw both fists back together beside your hip.",
      "start": 143.813999,
      "end": 148.20706,
      "turn": null,
      "kihap": false
    },
    {
      "index": 27,
      "text": "Chamber your right knee, then extend a side kick. Punch out to the side with your right fist.",
      "start": 150.070024,
      "end": 155.345081,
      "turn": null,
      "kihap": false
    },
    {
      "index": 28,
      "text": "Land in a front stance. Drive your left elbow toward the opposite open palm.",
      "start": 157.376044,
      "end": 162.267064,
      "turn": null,
      "kihap": false
    },
    {
      "index": 29,
      "text": "Turn left into a closed stance. Draw both fists back together beside your hip.",
      "start": 164.224878,
      "end": 168.919935,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 30,
      "text": "Extend the front knifehand while the other hand guards your body.",
      "start": 170.840422,
      "end": 174.129447,
      "turn": null,
      "kihap": false
    },
    {
      "index": 31,
      "text": "Set a front stance. Press downward with your left palm. Thrust your right fingertips forward as the other hand blocks.",
      "start": 175.782118,
      "end": 183.077129,
      "turn": null,
      "kihap": false
    },
    {
      "index": 32,
      "text": "Turn all the way around to the left. Rotate and lift your right wrist to release the grip.",
      "start": 185.492846,
      "end": 190.721871,
      "turn": {
        "side": "left",
        "degrees": 360
      },
      "kihap": false
    },
    {
      "index": 33,
      "text": "Strike forward with your left backfist.",
      "start": 192.744066,
      "end": 195.047105,
      "turn": null,
      "kihap": false
    },
    {
      "index": 34,
      "text": "Set a front stance. Punch to the middle with your right fist. Finish with a strong shout.",
      "start": 196.511969,
      "end": 202.332014,
      "turn": null,
      "kihap": true
    },
    {
      "index": 35,
      "text": "Make a three-quarter turn to your left, then set a front stance. Block outward with your left arm as the other arm blocks low.",
      "start": 204.466785,
      "end": 211.761796,
      "turn": {
        "side": "left",
        "degrees": 270
      },
      "kihap": false
    },
    {
      "index": 36,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 214.177513,
      "end": 217.084542,
      "turn": null,
      "kihap": false
    },
    {
      "index": 37,
      "text": "Land in a front stance. Punch to the middle with your right fist.",
      "start": 218.664453,
      "end": 222.697514,
      "turn": null,
      "kihap": false
    },
    {
      "index": 38,
      "text": "Punch to the middle with your left fist.",
      "start": 224.491907,
      "end": 226.701975,
      "turn": null,
      "kihap": false
    },
    {
      "index": 39,
      "text": "Turn right into a front stance. Block outward with your right arm as the other arm blocks low.",
      "start": 228.149131,
      "end": 234.214165,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 40,
      "text": "Chamber your left knee, then extend a front kick.",
      "start": 236.3956,
      "end": 239.336643,
      "turn": null,
      "kihap": false
    },
    {
      "index": 41,
      "text": "Land in a front stance. Punch to the middle with your left fist.",
      "start": 240.923032,
      "end": 244.677091,
      "turn": null,
      "kihap": false
    },
    {
      "index": 42,
      "text": "Punch to the middle with your right fist.",
      "start": 246.41834,
      "end": 248.315392,
      "turn": null,
      "kihap": false
    },
    {
      "index": 43,
      "text": "Return to the ready position.",
      "start": 250.06834,
      "end": 251.732422,
      "turn": null,
      "kihap": false
    }
