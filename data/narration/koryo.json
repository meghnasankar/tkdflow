  "cues": [
    {
      "index": 0,
      "text": "Stand ready with open hands in front of your chest.",
      "start": 0.12,
      "end": 2.8760090702947845,
      "turn": null,
      "kihap": false
    },
    {
      "index": 1,
      "text": "Set a back stance. Extend the front knifehand while the other hand guards your body.",
      "start": 3.256009,
      "end": 8.101043,
      "turn": null,
      "kihap": false
    },
    {
      "index": 2,
      "text": "Chamber your right knee, then extend a low side kick.",
      "start": 10.050097,
      "end": 13.154179,
      "turn": null,
      "kihap": false
    },
    {
      "index": 3,
      "text": "Re-chamber the same leg and extend the right side kick again.",
      "start": 14.771623,
      "end": 18.142643,
      "turn": null,
      "kihap": false
    },
    {
      "index": 4,
      "text": "Land in a front stance. Strike across with the edge of your right hand.",
      "start": 19.810933,
      "end": 23.797962,
      "turn": null,
      "kihap": false
    },
    {
      "index": 5,
      "text": "Punch to the middle with your left fist.",
      "start": 25.583587,
      "end": 27.793655,
      "turn": null,
      "kihap": false
    },
    {
      "index": 6,
      "text": "Set a back stance. Sweep your right forearm inward across your body.",
      "start": 29.240811,
      "end": 33.552874,
      "turn": null,
      "kihap": false
    },
    {
      "index": 7,
      "text": "Turn right into a back stance. Extend the front knifehand while the other hand guards your body.",
      "start": 35.40041,
      "end": 40.884446,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 8,
      "text": "Chamber your left knee, then extend a low side kick.",
      "start": 42.955215,
      "end": 46.163288,
      "turn": null,
      "kihap": false
    },
    {
      "index": 9,
      "text": "Re-chamber the same leg and extend the left side kick again.",
      "start": 47.800539,
      "end": 51.148566,
      "turn": null,
      "kihap": false
    },
    {
      "index": 10,
      "text": "Land in a front stance. Strike across with the edge of your left hand.",
      "start": 52.812476,
      "end": 56.914517,
      "turn": null,
      "kihap": false
    },
    {
      "index": 11,
      "text": "Punch to the middle with your right fist.",
      "start": 58.722048,
      "end": 60.6191,
      "turn": null,
      "kihap": false
    },
    {
      "index": 12,
      "text": "Set a back stance. Sweep your left forearm inward across your body.",
      "start": 62.272048,
      "end": 66.874089,
      "turn": null,
      "kihap": false
    },
    {
      "index": 13,
      "text": "Turn left into a front stance. Sweep your left knifehand down to block.",
      "start": 68.776858,
      "end": 73.331915,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 14,
      "text": "Extend your right arc hand forward at throat level.",
      "start": 75.225735,
      "end": 78.399749,
      "turn": null,
      "kihap": false
    },
    {
      "index": 15,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 80.030513,
      "end": 82.937542,
      "turn": null,
      "kihap": false
    },
    {
      "index": 16,
      "text": "Land in a front stance. Sweep your right knifehand down to block.",
      "start": 84.517453,
      "end": 88.619539,
      "turn": null,
      "kihap": false
    },
    {
      "index": 17,
      "text": "Extend your left arc hand forward at throat level.",
      "start": 90.427079,
      "end": 93.496104,
      "turn": null,
      "kihap": false
    },
    {
      "index": 18,
      "text": "Chamber your left knee, then extend a front kick.",
      "start": 95.106871,
      "end": 98.047914,
      "turn": null,
      "kihap": false
    },
    {
      "index": 19,
      "text": "Land in a front stance. Sweep your left knifehand down to block.",
      "start": 99.634303,
      "end": 103.702376,
      "turn": null,
      "kihap": false
    },
    {
      "index": 20,
      "text": "Extend your right arc hand forward at throat level. Finish with a strong shout.",
      "start": 105.503437,
      "end": 110.603482,
      "turn": null,
      "kihap": true
    },
    {
      "index": 21,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 112.60111,
      "end": 115.508139,
      "turn": null,
      "kihap": false
    },
    {
      "index": 22,
      "text": "Land in a front stance. Press down with your right hand while the other hand supports.",
      "start": 117.08805,
      "end": 122.154127,
      "turn": null,
      "kihap": false
    },
    {
      "index": 23,
      "text": "Turn right into a front stance. Spread both forearms outward into a middle block.",
      "start": 124.145285,
      "end": 129.315308,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 24,
      "text": "Chamber your left knee, then extend a front kick.",
      "start": 131.326264,
      "end": 134.267307,
      "turn": null,
      "kihap": false
    },
    {
      "index": 25,
      "text": "Land in a front stance. Press down with your left hand while the other hand supports.",
      "start": 135.853696,
      "end": 140.69873,
      "turn": null,
      "kihap": false
    },
    {
      "index": 26,
      "text": "Set a walking stance. Spread both forearms outward into a middle block.",
      "start": 142.647784,
      "end": 146.912818,
      "turn": null,
      "kihap": false
    },
    {
      "index": 27,
      "text": "Set a horse stance. Extend your left knifehand out to the side.",
      "start": 148.751396,
      "end": 152.924457,
      "turn": null,
      "kihap": false
    },
    {
      "index": 28,
      "text": "Punch with your right fist toward the opposite open palm.",
      "start": 154.745517,
      "end": 157.768556,
      "turn": null,
      "kihap": false
    },
    {
      "index": 29,
      "text": "Set a cross stance. Draw your hands in to prepare the next technique.",
      "start": 159.370563,
      "end": 163.472604,
      "turn": null,
      "kihap": false
    },
    {
      "index": 30,
      "text": "Chamber your left knee, then extend a side kick.",
      "start": 165.280135,
      "end": 168.001178,
      "turn": null,
      "kihap": false
    },
    {
      "index": 31,
      "text": "Land in a front stance. Thrust your left fingertips low, with the palm turned upward.",
      "start": 169.545662,
      "end": 174.70471,
      "turn": null,
      "kihap": false
    },
    {
      "index": 32,
      "text": "Set a walking stance. Sweep your right arm down for a low block.",
      "start": 176.713576,
      "end": 180.920605,
      "turn": null,
      "kihap": false
    },
    {
      "index": 33,
      "text": "Set a walking stance. Press downward with your left palm.",
      "start": 182.748135,
      "end": 186.212171,
      "turn": null,
      "kihap": false
    },
    {
      "index": 34,
      "text": "Drive your right elbow toward the opposite open palm.",
      "start": 187.898178,
      "end": 190.758178,
      "turn": null,
      "kihap": false
    },
    {
      "index": 35,
      "text": "Extend your right knifehand out to the side.",
      "start": 192.32913,
      "end": 194.88718,
      "turn": null,
      "kihap": false
    },
    {
      "index": 36,
      "text": "Punch with your left fist toward the opposite open palm.",
      "start": 196.400618,
      "end": 199.562659,
      "turn": null,
      "kihap": false
    },
    {
      "index": 37,
      "text": "Set a cross stance. Draw your hands in to prepare the next technique.",
      "start": 201.191143,
      "end": 205.293184,
      "turn": null,
      "kihap": false
    },
    {
      "index": 38,
      "text": "Chamber your right knee, then extend a side kick.",
      "start": 207.100715,
      "end": 209.86779,
      "turn": null,
      "kihap": false
    },
    {
      "index": 39,
      "text": "Land in a front stance. Thrust your right fingertips low, with the palm turned upward.",
      "start": 211.421042,
      "end": 216.730112,
      "turn": null,
      "kihap": false
    },
    {
      "index": 40,
      "text": "Set a walking stance. Sweep your left arm down for a low block.",
      "start": 218.767554,
      "end": 222.811636,
      "turn": null,
      "kihap": false
    },
    {
      "index": 41,
      "text": "Set a walking stance. Press downward with your right palm.",
      "start": 224.608127,
      "end": 228.385179,
      "turn": null,
      "kihap": false
    },
    {
      "index": 42,
      "text": "Drive your left elbow toward the opposite open palm.",
      "start": 230.130808,
      "end": 233.072849,
      "turn": null,
      "kihap": false
    },
    {
      "index": 43,
      "text": "Set a closed stance. Strike down with your left hammerfist toward the opposite palm.",
      "start": 234.659428,
      "end": 240.026457,
      "turn": null,
      "kihap": false
    },
    {
      "index": 44,
      "text": "Turn left into a front stance. Strike across with the edge of your left hand.",
      "start": 240.976457,
      "end": 245.555505,
      "turn": {
        "side": "left",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 45,
      "text": "Sweep your left knifehand down to block.",
      "start": 247.453895,
      "end": 250.081922,
      "turn": null,
      "kihap": false
    },
    {
      "index": 46,
      "text": "Set a front stance. Strike across with the edge of your right hand.",
      "start": 251.608689,
      "end": 255.455718,
      "turn": null,
      "kihap": false
    },
    {
      "index": 47,
      "text": "Sweep your right knifehand down to block.",
      "start": 257.214676,
      "end": 259.633724,
      "turn": null,
      "kihap": false
    },
    {
      "index": 48,
      "text": "Set a front stance. Strike across with the edge of your left hand.",
      "start": 261.120685,
      "end": 265.083724,
      "turn": null,
      "kihap": false
    },
    {
      "index": 49,
      "text": "Sweep your left knifehand down to block.",
      "start": 266.864779,
      "end": 269.492806,
      "turn": null,
      "kihap": false
    },
    {
      "index": 50,
      "text": "Set a front stance. Extend your right arc hand forward at throat level. Finish with a strong shout.",
      "start": 271.019573,
      "end": 277.432589,
      "turn": null,
      "kihap": true
    },
