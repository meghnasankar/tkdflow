  "cues": [
    {
      "index": 0,
      "text": "Stand ready, with your hands held in front.",
      "start": 0.12,
      "end": 2.159002267573696,
      "turn": null,
      "kihap": false
    },
    {
      "index": 1,
      "text": "Set a back stance. Move your left forearm outward to block.",
      "start": 2.539002,
      "end": 6.316054,
      "turn": null,
      "kihap": false
    },
    {
      "index": 2,
      "text": "Set a front stance. Raise your right forearm above your head to block.",
      "start": 8.061683,
      "end": 11.850753,
      "turn": null,
      "kihap": false
    },
    {
      "index": 3,
      "text": "Punch to the middle with your left fist.",
      "start": 13.611683,
      "end": 15.821751,
      "turn": null,
      "kihap": false
    },
    {
      "index": 4,
      "text": "Turn right into a back stance. Move your right forearm outward to block.",
      "start": 19.161683,
      "end": 23.600731,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 5,
      "text": "Set a front stance. Raise your left forearm above your head to block.",
      "start": 25.472454,
      "end": 29.29649,
      "turn": null,
      "kihap": false
    },
    {
      "index": 6,
      "text": "Punch to the middle with your right fist.",
      "start": 31.022454,
      "end": 32.919506,
      "turn": null,
      "kihap": false
    },
    {
      "index": 7,
      "text": "Turn left into a front stance. Sweep your left arm down for a low block.",
      "start": 36.572454,
      "end": 41.394495,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 8,
      "text": "Set a back stance. Raise your left knifehand above your head to block.",
      "start": 43.339169,
      "end": 47.418171,
      "turn": null,
      "kihap": false
    },
    {
      "index": 9,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 49.221315,
      "end": 52.128344,
      "turn": null,
      "kihap": false
    },
    {
      "index": 10,
      "text": "Land in a back stance. Lower the front knifehand while the other hand guards your body.",
      "start": 53.708255,
      "end": 58.380318,
      "turn": null,
      "kihap": false
    },
    {
      "index": 11,
      "text": "Move your right forearm outward to block.",
      "start": 60.296426,
      "end": 62.656471,
      "turn": null,
      "kihap": false
    },
    {
      "index": 12,
      "text": "Chamber your left knee, then extend a front kick.",
      "start": 69.132194,
      "end": 72.073237,
      "turn": null,
      "kihap": false
    },
    {
      "index": 13,
      "text": "Land in a back stance. Lower the front knifehand while the other hand guards your body.",
      "start": 73.659626,
      "end": 78.331689,
      "turn": null,
      "kihap": false
    },
    {
      "index": 14,
      "text": "Set a front stance. Raise your left forearm above your head to block.",
      "start": 80.247797,
      "end": 84.071833,
      "turn": null,
      "kihap": false
    },
    {
      "index": 15,
      "text": "Set a front stance. Draw both fists back together beside your hip.",
      "start": 90.826412,
      "end": 94.824462,
      "turn": null,
      "kihap": false
    },
    {
      "index": 16,
      "text": "Raise one arm high while the other fist punches forward.",
      "start": 96.612186,
      "end": 99.821211,
      "turn": null,
      "kihap": false
    },
    {
      "index": 17,
      "text": "Sweep your left forearm inward across your body.",
      "start": 101.458644,
      "end": 104.272703,
      "turn": null,
      "kihap": false
    },
    {
      "index": 18,
      "text": "Block inward with your right forearm, supported by the other hand.",
      "start": 105.834905,
      "end": 109.588964,
      "turn": null,
      "kihap": false
    },
    {
      "index": 19,
      "text": "Set a back stance. Sweep your left knifehand down to block.",
      "start": 111.330213,
      "end": 115.037288,
      "turn": null,
      "kihap": false
    },
    {
      "index": 20,
      "text": "Chamber your right knee, then extend a front kick.",
      "start": 116.769588,
      "end": 119.676617,
      "turn": null,
      "kihap": false
    },
    {
      "index": 21,
      "text": "Land in a front stance. Punch to the middle with your right fist.",
      "start": 121.256528,
      "end": 125.289589,
      "turn": null,
      "kihap": false
    },
    {
      "index": 22,
      "text": "Punch to the middle with your left fist.",
      "start": 127.083982,
      "end": 129.29405,
      "turn": null,
      "kihap": false
    },
    {
      "index": 23,
      "text": "Turn left into a horse stance. Bring both forearms up to guard above your head.",
      "start": 130.741206,
      "end": 135.51726,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 24,
      "text": "Sweep your left arm down and out for the low side block.",
      "start": 137.453176,
      "end": 140.534219,
      "turn": null,
      "kihap": false
    },
    {
      "index": 25,
      "text": "Extend your right knifehand out to the side.",
      "start": 142.147275,
      "end": 144.705325,
      "turn": null,
      "kihap": false
    },
    {
      "index": 26,
      "text": "Strike down with your left hammerfist toward the opposite palm. Finish with a strong shout.",
      "start": 146.218763,
      "end": 151.598808,
      "turn": null,
      "kihap": true
    },
    {
      "index": 27,
      "text": "Balance on your left leg. Sweep your right arm down and out for the low side block.",
      "start": 153.649769,
      "end": 158.762785,
      "turn": null,
      "kihap": false
    },
    {
      "index": 28,
      "text": "Balance on your left leg. Draw both fists back together beside your hip.",
      "start": 160.762883,
      "end": 165.155944,
      "turn": null,
      "kihap": false
    },
    {
      "index": 29,
      "text": "Chamber your right knee, then extend a side kick.",
      "start": 167.018908,
      "end": 169.785983,
      "turn": null,
      "kihap": false
    },
    {
      "index": 30,
      "text": "Balance on your right leg. Sweep your left arm down and out for the low side block.",
      "start": 171.339235,
      "end": 176.289258,
      "turn": null,
      "kihap": false
    },
    {
      "index": 31,
      "text": "Balance on your right leg. Draw both fists back together beside your hip.",
      "start": 178.25831,
      "end": 182.685385,
      "turn": null,
      "kihap": false
    },
    {
      "index": 32,
      "text": "Chamber your left knee, then extend a side kick.",
      "start": 184.554828,
      "end": 187.275871,
      "turn": null,
      "kihap": false
    },
    {
      "index": 33,
      "text": "Land in a front stance. Punch to the middle with your right fist.",
      "start": 188.820355,
      "end": 192.853416,
      "turn": null,
      "kihap": false
    },
    {
      "index": 34,
      "text": "Set a front stance. Punch to the middle with your right fist. Finish with a strong shout.",
      "start": 194.647809,
      "end": 200.467854,
      "turn": null,
      "kihap": true
    },
    {
      "index": 35,
      "text": "Turn left into a back stance. Lower the front knifehand while the other hand guards your body.",
      "start": 202.602625,
      "end": 208.005664,
      "turn": {
        "side": "left",
        "degrees": 270
      },
      "kihap": false
    },
    {
      "index": 36,
      "text": "Set a back stance. Extend the front knifehand while the other hand guards your body.",
      "start": 210.061004,
      "end": 214.906038,
      "turn": null,
      "kihap": false
    },
    {
      "index": 37,
      "text": "Turn right into a back stance. Lower the front knifehand while the other hand guards your body.",
      "start": 216.855092,
      "end": 222.165115,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 38,
      "text": "Set a back stance. Extend the front knifehand while the other hand guards your body.",
      "start": 224.202738,
      "end": 229.047772,
      "turn": null,
      "kihap": false
    },
    {
      "index": 39,
      "text": "Return to the ready position.",
      "start": 231.096826,
      "end": 232.760908,
      "turn": null,
      "kihap": false
    }
  ],
