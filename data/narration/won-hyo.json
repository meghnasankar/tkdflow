  "cues": [
    {
      "index": 0,
      "text": "Stand with your feet together and hands near your face.",
      "start": 0.12,
      "end": 3.167074829931973,
      "turn": null,
      "kihap": false
    },
    {
      "index": 1,
      "text": "Turn left into a back stance. Raise one forearm high while the other forearm blocks forward.",
      "start": 3.547075,
      "end": 9.634104,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 2,
      "text": "Strike inward with your right knifehand.",
      "start": 11.819729,
      "end": 13.959774,
      "turn": null,
      "kihap": false
    },
    {
      "index": 3,
      "text": "Punch to the middle with your left fist.",
      "start": 15.393593,
      "end": 17.603661,
      "turn": null,
      "kihap": false
    },
    {
      "index": 4,
      "text": "Turn right into a back stance. Raise one forearm high while the other forearm blocks forward.",
      "start": 19.050817,
      "end": 25.034853,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 5,
      "text": "Strike inward with your left knifehand.",
      "start": 27.20086,
      "end": 29.154919,
      "turn": null,
      "kihap": false
    },
    {
      "index": 6,
      "text": "Punch to the middle with your right fist.",
      "start": 30.75086,
      "end": 32.647912,
      "turn": null,
      "kihap": false
    },
    {
      "index": 7,
      "text": "Turn left into a one-leg stance. Chamber your left leg beside the supporting knee.",
      "start": 34.30086,
      "end": 40.179908,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 8,
      "text": "Chamber your left knee, then extend a side kick.",
      "start": 41.129908,
      "end": 43.850951,
      "turn": null,
      "kihap": false
    },
    {
      "index": 9,
      "text": "Land in a back stance. Extend your left knifehand to block.",
      "start": 45.395435,
      "end": 49.277476,
      "turn": null,
      "kihap": false
    },
    {
      "index": 10,
      "text": "Set a back stance. Extend your right knifehand to block.",
      "start": 51.043103,
      "end": 54.495166,
      "turn": null,
      "kihap": false
    },
    {
      "index": 11,
      "text": "Set a back stance. Extend your left knifehand to block.",
      "start": 56.178893,
      "end": 59.432952,
      "turn": null,
      "kihap": false
    },
    {
      "index": 12,
      "text": "Set a walking stance. Thrust your right fingertips forward with the other hand supporting.",
      "start": 61.078963,
      "end": 66.28504,
      "turn": null,
      "kihap": false
    },
    {
      "index": 13,
      "text": "Make a three-quarter turn to your left, then set a back stance. Raise one forearm high while the other forearm blocks forward.",
      "start": 68.302864,
      "end": 75.900914,
      "turn": {
        "side": "left",
        "degrees": 270
      },
      "kihap": false
    },
    {
      "index": 14,
      "text": "Strike inward with your right knifehand.",
      "start": 78.374352,
      "end": 80.514397,
      "turn": null,
      "kihap": false
    },
    {
      "index": 15,
      "text": "Punch to the middle with your left fist.",
      "start": 81.948216,
      "end": 84.158284,
      "turn": null,
      "kihap": false
    },
    {
      "index": 16,
      "text": "Turn right into a back stance. Raise one forearm high while the other forearm blocks forward.",
      "start": 85.60544,
      "end": 91.589476,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 17,
      "text": "Strike inward with your left knifehand.",
      "start": 93.755483,
      "end": 95.709542,
      "turn": null,
      "kihap": false
    },
    {
      "index": 18,
      "text": "Punch to the middle with your right fist.",
      "start": 97.305483,
      "end": 99.202535,
      "turn": null,
      "kihap": false
    },
    {
      "index": 19,
      "text": "Turn left into a walking stance. Guide your right forearm around in a circular block.",
      "start": 100.855483,
      "end": 105.701515,
      "turn": {
        "side": "left",
        "degrees": 90
      },
      "kihap": false
    },
    {
      "index": 20,
      "text": "Chamber your right knee, then extend a low front kick.",
      "start": 107.650759,
      "end": 110.719829,
      "turn": null,
      "kihap": false
    },
    {
      "index": 21,
      "text": "Land in a walking stance. Punch to the middle with your left fist.",
      "start": 112.330605,
      "end": 116.920673,
      "turn": null,
      "kihap": false
    },
    {
      "index": 22,
      "text": "Guide your left forearm around in a circular block.",
      "start": 118.821162,
      "end": 121.403248,
      "turn": null,
      "kihap": false
    },
    {
      "index": 23,
      "text": "Chamber your left knee, then extend a low front kick.",
      "start": 122.921265,
      "end": 125.805301,
      "turn": null,
      "kihap": false
    },
    {
      "index": 24,
      "text": "Land in a walking stance. Punch to the middle with your right fist.",
      "start": 127.380832,
      "end": 132.086864,
      "turn": null,
      "kihap": false
    },
    {
      "index": 25,
      "text": "Chamber your right leg beside the supporting knee.",
      "start": 134.009441,
      "end": 136.451482,
      "turn": null,
      "kihap": false
    },
    {
      "index": 26,
      "text": "Chamber your right knee, then extend a side kick.",
      "start": 137.559441,
      "end": 140.326516,
      "turn": null,
      "kihap": false
    },
    {
      "index": 27,
      "text": "Make a three-quarter turn to your left, then set a back stance. Set your left forearm forward with the other arm guarding.",
      "start": 141.879768,
      "end": 148.89682,
      "turn": {
        "side": "left",
        "degrees": 270
      },
      "kihap": false
    },
    {
      "index": 28,
      "text": "Turn right into a back stance. Set your right forearm forward with the other arm guarding.",
      "start": 151.259592,
      "end": 156.348617,
      "turn": {
        "side": "right",
        "degrees": 180
      },
      "kihap": false
    },
    {
      "index": 29,
      "text": "Return to the ready position.",
      "start": 158.444146,
      "end": 160.108228,
      "turn": null,
      "kihap": false
    }
  ],
